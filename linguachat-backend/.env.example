CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# WHICH AI PROVIDER THIS PROCESS MAY USE
#
#   local   (default)  the deterministic local engine. Real conversations, no
#                      network, no cost. Use this for development and QA.
#   fake               scripted evaluation scenarios (see LINGUACHAT_FAKE_PROVIDER)
#   openai             the real model. Requires OPENAI_API_KEY.
#
# A key on its own does NOT enable the real provider. Having one is a capability;
# using it is a decision, and the decision is this line. Leaving this unset — or
# setting it to something unrecognised — means local.
LINGUACHAT_PROVIDER=local

# To deliberately test the real provider:
#   LINGUACHAT_PROVIDER=openai
#   OPENAI_API_KEY=sk-...           (never commit a real key)
# Asking for openai without a key makes the server refuse to start, rather than
# quietly serving local answers to somebody who thinks they are testing OpenAI.
# OPENAI_API_KEY=

# To exercise the remote evaluation path without any network — slow answers,
# malformed answers, timeouts, which a real model cannot be made to do on demand:
#   LINGUACHAT_PROVIDER=fake
#   LINGUACHAT_FAKE_PROVIDER=success | timeout | invalid | contradictory | error | disabled
#   LINGUACHAT_FAKE_DELAY=6         (seconds, optional)
#   LINGUACHAT_EVAL_TIMEOUT=2       (seconds, optional)
# Setting LINGUACHAT_FAKE_PROVIDER alone also selects fake mode, and fake wins
# over openai: a scripted test must never silently become a live one.

# A kill switch on REAL requests, independent of everything above. It does not
# disable the fake, which makes no requests.
OPENAI_ENABLED=true

OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=20
