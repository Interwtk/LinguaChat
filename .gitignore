# OS / editor
.DS_Store
Thumbs.db
.vscode/

# User-owned archives live beside the repo and are never part of it. CI already
# refuses a tracked .zip; this stops `git add -A` from staging one in the first place.
*.zip

# local QA cycles and auth QA output
.qa/
auth-qa-result.json

# per-cycle safety measurements (the committed baselines stay)
linguachat-backend/tests/safety_eval/results/*-qa-*.json
linguachat-backend/tests/guided_eval/results/*-qa-*.json
