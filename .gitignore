# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Environment
.env
.env.local
.env.*.local

# Node / React
node_modules/
build/
dist/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
