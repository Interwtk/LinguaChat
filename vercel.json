{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'Frontend dependencies are installed by buildCommand'",
  "buildCommand": "cd linguachat-frontend && npm ci && npm run build",
  "outputDirectory": "linguachat-frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "includeFiles": "linguachat-backend/**",
      "excludeFiles": "linguachat-backend/{tests/**,__pycache__/**}"
    }
  }
}
