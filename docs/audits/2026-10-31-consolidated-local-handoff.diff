++  const bProfile = b.access.getItem('lc2-profile')
++  const a = signedIn({ 'lc2-profile': '{bad', 'lc2-onboarded': 'true' }, 'A', shared)
++  let switched = false
++  shared.onSet = key => {
++    if (!switched && key.includes('lc2-quarantine:')) {
++      switched = true
