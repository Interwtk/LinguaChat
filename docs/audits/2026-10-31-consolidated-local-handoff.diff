diff -ruN a/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs b/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs
--- a/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs	2026-10-31 19:20:53.517819900 -0300
@@ -0,0 +1,155 @@
+#!/usr/bin/env node
+/*
+ * curriculum-readiness-matrix — the Pre-A1 / A1 coverage tables, computed (P3).
+ *
+ * Every number in docs/curriculum/pre-a1-a1-readiness-matrix.md between the
+ * generated markers comes from here: the runtime skeleton, the content loader
+ * (each episode's content is really loaded), the level gate, the eight
+ * locales, the A1 blueprint and the test suites that cover each episode.
+ * Nothing is typed by hand, so the matrix cannot claim more than the code has.
+ *
+ *   node scripts/curriculum-readiness-matrix.mjs           print the tables
+ *   node scripts/curriculum-readiness-matrix.mjs --write   refresh the document
+ *   node scripts/curriculum-readiness-matrix.mjs --check   fail if it is stale
+ */
+import { readFileSync, writeFileSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { EPISODE_SKELETON } from '../src/learning/curriculum/preA1Skeleton.generated.js'
+import { loadEpisodeContent, episodeRequest, hasContentLoader } from '../src/learning/curriculum/episodeContent.js'
+import { PRE_A1_EXIT_CRITERIA } from '../src/learning/curriculum/preA1Map.js'
+import { isLevelAvailable } from '../src/learning/curriculum/levels.js'
+import { extractBase, extractLocale, LOCALE_ORDER, TRANSLATIONS_PATH, LOCALES_DIR } from './lib/i18nSource.mjs'
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url))
+const REPO = join(ROOT, '..')
+const DOC = join(REPO, 'docs/curriculum/pre-a1-a1-readiness-matrix.md')
+const blueprint = JSON.parse(readFileSync(join(REPO, 'docs/curriculum/a1-blueprint.json'), 'utf8'))
+
+const OPEN = new Set(['free_reply'])
+const RECALL = new Set(['recall'])
+const CLOSED = new Set(['choice', 'word_order', 'fill_blank', 'comprehension'])
+
+// i18n: the English source and each locale, read exactly as the i18n checks read them
+const base = extractBase(readFileSync(TRANSLATIONS_PATH, 'utf8')).dict
+const locales = Object.fromEntries(LOCALE_ORDER.map(code => [code, extractLocale(readFileSync(join(LOCALES_DIR, `${code}.js`), 'utf8')).dict]))
+
+function files(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name)
+    if (['node_modules', '.venv', '__pycache__'].includes(name)) continue
+    if (statSync(path).isDirectory()) files(path, out)
+    else if (/\.(mjs|py)$/.test(name) && !name.startsWith('curriculum-readiness-matrix')) out.push(path)
+  }
+  return out
+}
+const testSources = [...files(join(ROOT, 'scripts')), ...files(join(REPO, 'linguachat-backend/tests'))]
+  .map(path => ({ path: path.replace(/\\/g, '/'), text: readFileSync(path, 'utf8') }))
+
+// Suites that walk a whole level or arc without naming each episode id.
+const LEVEL_WIDE = {
+  'Pre-A1': /check-pre-a1-journeys|check-pedagogical-journeys|check-pre-a1-freeze|check-episodes\.mjs|check-arc-e2e/,
+  A1: /check-a1-longitudinal-journeys|check-pedagogical-journeys|check-a1-blueprint/,
+}
+
+async function episodeRows(level) {
+  const rows = []
+  for (const ep of EPISODE_SKELETON.filter(e => e.level === level)) {
+    const types = ep.steps.map(s => s.type)
+    let loaded = 0
+    try { loaded = (await loadEpisodeContent({ episodeId: ep.id, forLearner: false })).steps?.length || 0 } catch { loaded = 0 }
+    const prefix = ep.titleKey.replace(/Title$/, '')
+    const keys = Object.keys(base).filter(k => k.startsWith(prefix) && /^[A-Z]/.test(k.slice(prefix.length)))
+    const missing = LOCALE_ORDER.filter(code => keys.some(k => !locales[code][k]))
+    const arcOrder = level === 'A1' ? blueprint.arcs.find(a => a.id === ep.arc)?.order : null
+    const arcModule = arcOrder ? new RegExp(`a1Arc_?${arcOrder}(?![0-9])`) : null
+    const byId = testSources.filter(t => t.text.includes(`'${ep.id}'`) || t.text.includes(`"${ep.id}"`)).length
+    const byArc = testSources.filter(t => t.text.includes(`'${ep.arc}'`) || (arcModule && arcModule.test(t.text))
+      || LEVEL_WIDE[level].test(t.path)).length
+    rows.push({
+      id: ep.id, arc: ep.arc, canDo: ep.canDoId, secondary: ep.secondaryCanDoId || null,
+      open: types.filter(t => OPEN.has(t)).length,
+      recall: types.filter(t => RECALL.has(t)).length,
+      closed: types.filter(t => CLOSED.has(t)).length,
+      loader: hasContentLoader(level === 'Pre-A1' ? 'pre_a1' : 'a1', ep.arc),
+      loadedSteps: loaded,
+      learnerCanOpen: episodeRequest({ episodeId: ep.id }).ok,
+      keys: keys.length,
+      localesComplete: missing.length === 0 ? '8/8' : `${8 - missing.length}/8 (${missing.join(',')})`,
+      byId, byArc,
+    })
+  }
+  return rows
+}
+
+function table(rows) {
+  const head = '| Episodio | Arco | Capacidad | Abiertas | Recuerdo | Cerradas | Contenido carga (pasos) | Estudiante puede abrir | Claves i18n | Idiomas completos | Pruebas: por id / por arco o nivel |'
+  const sep = '|---|---|---|---|---|---|---|---|---|---|---|'
+  const line = r => [
+    '`' + r.id + '`', r.arc, r.canDo + (r.secondary ? ` (+${r.secondary})` : ''), r.open, r.recall, r.closed,
+    r.loader && r.loadedSteps ? `sí (${r.loadedSteps})` : 'NO', r.learnerCanOpen ? 'sí' : 'no (cerrado)',
+    r.keys, r.localesComplete, `${r.byId} / ${r.byArc}`,
+  ].join(' | ')
+  return [head, sep, ...rows.map(r => `| ${line(r)} |`)].join('\n')
+}
+
+function coverage(canDos, rows) {
+  const head = '| Capacidad | Alcance | Episodios (propio o secundario) | Producciones abiertas | Pasos de recuerdo diferido | Reutilizada en otros episodios (transferencia) |'
+  const sep = '|---|---|---|---|---|---|'
+  const lines = canDos.map(c => {
+    const own = rows.filter(r => r.canDo === c.id || r.secondary === c.id)
+    const reuse = EPISODE_SKELETON.filter(e => (e.reuseSkills || []).includes(c.id)).length
+    return `| ${c.id} | ${c.scope} | ${own.length} | ${own.reduce((n, r) => n + r.open, 0)} | ${own.reduce((n, r) => n + r.recall, 0)} | ${reuse} |`
+  })
+  return [head, sep, ...lines].join('\n')
+}
+
+export async function computeMatrix() {
+  const pre = await episodeRows('Pre-A1')
+  const a1 = await episodeRows('A1')
+  const preCanDos = PRE_A1_EXIT_CRITERIA.requiredCanDos.map(id => ({ id, scope: 'required (exit)' }))
+  const a1CanDos = blueprint.canDos.map(c => ({ id: c.id, scope: c.scope }))
+  const uncovered = a1CanDos.filter(c => !a1.some(r => r.canDo === c.id || r.secondary === c.id)).map(c => c.id)
+  const sum = (rows, key) => rows.reduce((n, r) => n + r[key], 0)
+  const summary = [
+    '| Medida | Pre-A1 | A1 |',
+    '|---|---|---|',
+    `| Nivel abierto a estudiantes | ${isLevelAvailable('pre_a1') ? 'sí' : 'no'} | ${isLevelAvailable('a1') ? 'sí' : 'no'} |`,
+    `| Episodios en runtime / planificados | ${pre.length} / 17 | ${a1.length} / ${blueprint.episodes.length} |`,
+    `| Episodios cuyo contenido carga de verdad | ${pre.filter(r => r.loadedSteps).length} | ${a1.filter(r => r.loadedSteps).length} |`,
+    `| Episodios que un estudiante puede abrir hoy | ${pre.filter(r => r.learnerCanOpen).length} | ${a1.filter(r => r.learnerCanOpen).length} |`,
+    `| Episodios con i18n completo en los 8 idiomas | ${pre.filter(r => r.localesComplete === '8/8').length} | ${a1.filter(r => r.localesComplete === '8/8').length} |`,
+    `| Producciones abiertas (free_reply) | ${sum(pre, 'open')} | ${sum(a1, 'open')} |`,
+    `| Pasos de recuerdo diferido (recall) | ${sum(pre, 'recall')} | ${sum(a1, 'recall')} |`,
+    `| Episodios sin prueba que los nombre por id | ${pre.filter(r => !r.byId).length} | ${a1.filter(r => !r.byId).length} |`,
+    `| Episodios sin ninguna prueba (ni por id ni por arco/nivel) | ${pre.filter(r => !r.byId && !r.byArc).length} | ${a1.filter(r => !r.byId && !r.byArc).length} |`,
+    `| Capacidades del blueprint sin episodio (propio o secundario) | — | ${uncovered.length ? uncovered.join(', ') : 'ninguna'} |`,
+  ].join('\n')
+  return [
+    '### Resumen calculado', '', summary, '',
+    '### Pre-A1 — episodios', '', table(pre), '',
+    '### Pre-A1 — capacidades exigidas para graduarse', '', coverage(preCanDos, pre), '',
+    '### A1 — episodios', '', table(a1), '',
+    '### A1 — capacidades del blueprint', '', coverage(a1CanDos, a1),
+  ].join('\n')
+}
+
+const START = '<!-- generated:start (node scripts/curriculum-readiness-matrix.mjs --write) -->'
+const END = '<!-- generated:end -->'
+
+const generated = await computeMatrix()
+if (process.argv.includes('--write') || process.argv.includes('--check')) {
+  const doc = readFileSync(DOC, 'utf8')
+  const a = doc.indexOf(START), b = doc.indexOf(END)
+  if (a < 0 || b < a) throw new Error('generated markers missing in ' + DOC)
+  const next = doc.slice(0, a + START.length) + '\n\n' + generated + '\n\n' + doc.slice(b)
+  if (process.argv.includes('--check')) {
+    if (next !== doc) { console.error('curriculum-readiness-matrix — STALE: run with --write'); process.exit(1) }
+    console.log('curriculum-readiness-matrix — OK (the document matches the runtime)')
+  } else {
+    writeFileSync(DOC, next)
+    console.log('curriculum-readiness-matrix — written')
+  }
+} else {
+  console.log(generated)
+}
diff -ruN a/linguachat-frontend/scripts/e2e-chat-continuity.mjs b/linguachat-frontend/scripts/e2e-chat-continuity.mjs
--- a/linguachat-frontend/scripts/e2e-chat-continuity.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/e2e-chat-continuity.mjs	2026-10-31 19:20:53.518814100 -0300
@@ -0,0 +1,120 @@
+#!/usr/bin/env node
+/*
+ * e2e-chat-continuity — the whole loop across the real HTTP boundary (P3).
+ *
+ * Needs a running backend with the free local engine:
+ *   cd linguachat-backend && LINGUACHAT_PROVIDER=local python -m uvicorn main:app --port 8000
+ *   node scripts/e2e-chat-continuity.mjs [http://127.0.0.1:8000]
+ *
+ * Each learner sends real messages to POST /chat. The device side is the real
+ * frontend code: services/chatAnalysis.js reduces the reply, chatEvidence.js
+ * classifies and records it in a real learner model, and the memory it builds
+ * travels back in the next request — exactly what AppContext does. Days are
+ * simulated by the turn times; nothing about the server is mocked.
+ *
+ * Not part of check:all (it needs a server). The P3 report records its run.
+ */
+import assert from 'node:assert/strict'
+import { safeAnalysis } from '../src/services/chatAnalysis.js'
+import { classifyChatTurn, recordChatTurn, chatDifficulties, learningMemoryPayload } from '../src/learning/engine/chatEvidence.js'
+import { createLearnerModel } from '../src/learning/engine/learnerModel.js'
+import { isLevelAvailable } from '../src/learning/curriculum/levels.js'
+
+const API = process.argv[2] || 'http://127.0.0.1:8000'
+const DAY = 86400000
+const T0 = Date.UTC(2026, 9, 10, 9)
+let passed = 0
+const failures = []
+async function scenario(name, run) {
+  try { await run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+
+function learner(lang) {
+  const model = createLearnerModel()
+  let last = null, n = 0
+  return {
+    model,
+    set lang(v) { lang = v },
+    async say(message, { day = 0, minute = 0, session = `day${day}`, assisted = false } = {}) {
+      const at = T0 + day * DAY + minute * 60000
+      const res = await fetch(`${API}/chat`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ session_id: `${lang}-${session}`, message, level: 'A1', native_language: lang,
+          learning_memory: learningMemoryPayload(model, at) }),
+      })
+      assert.equal(res.status, 200)
+      const data = await res.json()
+      const analysis = safeAnalysis(data.analysis)
+      const c = classifyChatTurn({ turnId: `t${++n}`, at, message, analysis, assisted, model,
+        previous: last ? { correction: last.correction, retrieval: last.retrieval } : null })
+      recordChatTurn(model, c)
+      last = { correction: data.correction, retrieval: analysis?.retrieval || null }
+      return { data, kind: c.kind, at }
+    },
+    difficulty: (rule, at) => chatDifficulties(model, at).find(d => d.rule === rule),
+  }
+}
+
+await scenario('a beginner across five days: error → copy → delayed retrieval → transfer, never mastery', async () => {
+  const l = learner('es')
+  const d1 = await l.say('Yesterday I goed to school.', { day: 0 })
+  assert.equal(d1.kind, 'error'); assert.equal(d1.data.analysis.strategy, 'brief_explanation')
+  assert.equal((await l.say('Yesterday I went to school.', { day: 0, minute: 1 })).kind, 'copied')
+  // day 2: the device says it is due; the tutor offers a retrieval with a new verb
+  const d2 = await l.say('I like my job.', { day: 1, minute: 60 })
+  const retrieval = d2.data.analysis.retrieval
+  assert.ok(retrieval && retrieval.base !== 'go', 'a delayed retrieval in a new sentence')
+  assert.match(d2.data.learning_action.prompt, /Un repaso rápido de otro día/)
+  assert.equal((await l.say(retrieval.expected, { day: 1, minute: 62 })).kind, 'retrieval')
+  // day 5: spontaneous use of another irregular past
+  assert.equal((await l.say('Last weekend we swam in the lake.', { day: 4 })).kind, 'transfer')
+  const d = l.difficulty('past_irregular', T0 + 4 * DAY + 1)
+  assert.equal(d.status, 'holding'); assert.equal(d.curricular, false)
+  assert.equal(isLevelAvailable('a1'), false, 'A1 stays closed whatever the chat saw')
+})
+
+await scenario('the same error on three days: the method changes, chosen by the teaching policy', async () => {
+  const l = learner('ja')
+  await l.say('Yesterday I goed home.', { day: 0 })
+  const offer = await l.say('I like tea.', { day: 1, minute: 60 })
+  await l.say('writed', { day: 1, minute: 61 })                         // the retrieval misses
+  const third = await l.say('Last week I buyed shoes.', { day: 2 })
+  const d = l.difficulty('past_irregular', T0 + 2 * DAY + 1)
+  assert.equal(d.status, 'recurring')
+  assert.ok(offer.data.analysis.retrieval)
+  // the server started this new conversation with the policy's choice, not the light touch
+  assert.notEqual(third.data.analysis.strategy, 'brief_explanation')
+  assert.match(third.data.explanation, /[ぁ-んァ-ン一-龯]/, 'explained in the learner’s language')
+})
+
+await scenario('a fast learner: no difficulty, no retrieval, nothing remembered', async () => {
+  const l = learner('fr')
+  for (const [i, m] of ['Yesterday I went to the cinema.', 'Last week we ate pizza.', 'I bought a new bike.'].entries()) {
+    const r = await l.say(m, { day: i })
+    assert.notEqual(r.data.analysis.verdict, 'error')
+    assert.equal(r.data.analysis.retrieval, undefined)
+  }
+  assert.deepEqual(chatDifficulties(l.model, T0 + 5 * DAY), [], 'correct use alone creates no difficulty')
+  assert.deepEqual(learningMemoryPayload(l.model, T0 + 5 * DAY), [])
+})
+
+await scenario('switching the auxiliary language keeps the memory and changes only the words', async () => {
+  const l = learner('es')
+  await l.say('She like music.', { day: 0 })
+  l.lang = 'ar'
+  const r = await l.say('I like my city.', { day: 2 })
+  assert.equal(r.data.analysis.retrieval?.rule, 'third_person', 'the difficulty followed the learner')
+  assert.match(r.data.learning_action.prompt, /[؀-ۿ]/, 'now framed in Arabic')
+})
+
+await scenario('ambiguous, out of scope and insufficient turns are not evidence either way', async () => {
+  const l = learner('de')
+  assert.equal((await l.say('Hallo, wie geht es?', { day: 0 })).kind, 'not_evaluable')
+  assert.equal((await l.say('ok', { day: 0, minute: 1 })).kind, 'not_evaluable')
+  assert.equal((await l.say('I am agree with you.', { day: 0, minute: 2 })).kind, 'insufficient', 'beyond the rules: no claim')
+  assert.deepEqual(chatDifficulties(l.model, T0 + DAY), [])
+})
+
+console.log(`\ne2e-chat-continuity — ${passed} passed, ${failures.length} failed  (${API})`)
+if (failures.length) process.exitCode = 1
diff -ruN a/linguachat-frontend/scripts/e2e-tutor-runtime.mjs b/linguachat-frontend/scripts/e2e-tutor-runtime.mjs
--- a/linguachat-frontend/scripts/e2e-tutor-runtime.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/e2e-tutor-runtime.mjs	2026-10-31 19:20:53.519821700 -0300
@@ -0,0 +1,162 @@
+#!/usr/bin/env node
+/*
+ * e2e-tutor-runtime — Lingua's evaluator in a real conversation, end to end (P5).
+ *
+ * Needs a running backend with the free local engine:
+ *   cd linguachat-backend && LINGUACHAT_PROVIDER=local python -m uvicorn main:app --port 8011
+ *   node scripts/e2e-tutor-runtime.mjs [http://127.0.0.1:8011]
+ *
+ * The learner sends real messages to POST /chat over HTTP, with the request
+ * body AppContext sends (including `assistance` and the device's learning
+ * memory). The device side is the real frontend code: chatAnalysis.safeAnalysis
+ * reduces the reply (with the evaluator's proposal), chatEvidence classifies
+ * and records the turn in a real learner model, teachingPolicy decides across
+ * days. Days are simulated by the turn times; nothing on the server is mocked.
+ *
+ * The brief's ten steps, in order:
+ *   1 a wrong sentence → 2 a validated finding → 3 the correction in the learner's
+ *   language → 4 the learner uses help → 5 recorded as assisted → 6 the same
+ *   difficulty on a later day → 7 Lingua changes strategy → 8 an independent
+ *   later attempt → 9 retrieval told apart from transfer → 10 what the screens
+ *   may show: chat observations only, never curriculum, level or milestone.
+ *
+ * Not in check:all (it needs a server). The P5 report records its run.
+ */
+import assert from 'node:assert/strict'
+import { safeAnalysis } from '../src/services/chatAnalysis.js'
+import { classifyChatTurn, recordChatTurn, chatDifficulties, learningMemoryPayload } from '../src/learning/engine/chatEvidence.js'
+import { createLearnerModel } from '../src/learning/engine/learnerModel.js'
+import { derivePreA1Readiness } from '../src/learning/curriculum/readiness.js'
+import { deriveLearnerLevel } from '../src/learning/curriculum/learnerLevel.js'
+import { isLevelAvailable } from '../src/learning/curriculum/levels.js'
+
+const API = process.argv[2] || 'http://127.0.0.1:8011'
+const DAY = 86400000
+const T0 = Date.UTC(2026, 10, 2, 9)
+// the server keeps a short memory per session id: every run uses fresh ones
+const RUN = Date.now().toString(36)
+let passed = 0
+const failures = []
+async function scenario(name, run) {
+  try { await run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+
+function learner(lang, id) {
+  const model = createLearnerModel()
+  let last = null, n = 0
+  const log = []
+  return {
+    model, log,
+    async say(message, { day = 0, minute = 0, assisted = false } = {}) {
+      const at = T0 + day * DAY + minute * 60000
+      const res = await fetch(`${API}/chat`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ session_id: `${RUN}-${id}-d${day}`, message, level: 'A1', native_language: lang,
+          learning_memory: learningMemoryPayload(model, at), ...(assisted ? { assistance: 'suggestion_sent' } : {}) }),
+      })
+      assert.equal(res.status, 200)
+      assert.equal(res.headers.get('x-linguachat-provider'), 'local')
+      const data = await res.json()
+      const analysis = safeAnalysis(data.analysis, data.evaluation)
+      const c = classifyChatTurn({ turnId: `${id}-t${++n}`, at, message, analysis, assisted, model,
+        previous: last ? { correction: last.correction, retrieval: last.retrieval } : null })
+      recordChatTurn(model, c)
+      last = { correction: data.correction, retrieval: analysis?.retrieval || null }
+      log.push({ message, kind: c.kind, evidence: data.evaluation?.evidence?.kind, strategy: data.analysis?.strategy })
+      return { data, kind: c.kind, at }
+    },
+    difficulty: (rule, at) => chatDifficulties(model, at).find(d => d.rule === rule),
+  }
+}
+
+await scenario('the ten steps: error → help → assisted → later error → strategy change → retrieval → transfer', async () => {
+  const l = learner('es', 'ten')
+  const curriculumBefore = JSON.stringify({ canDo: l.model.canDo, items: l.model.languageItems, ms: l.model.levelMilestones || null })
+
+  // 1–3: a wrong sentence; a validated local finding; the correction in Spanish
+  const t1 = await l.say('Yesterday I goed to the park with my friends.', { day: 0 })
+  assert.equal(t1.data.evaluation.version, 'chat-evaluation/1')
+  assert.equal(t1.data.evaluation.used, 'local_rules')
+  assert.equal(t1.data.evaluation.evidence.kind, 'error')
+  assert.equal(t1.data.correction, 'Yesterday I went to the park with my friends.')
+  assert.match(t1.data.explanation, /pasado|irregular/)
+  assert.equal(t1.kind, 'error')
+
+  // 4–5: the learner sends Lingua's correction, from the suggestion (help)
+  const t2 = await l.say(t1.data.correction, { day: 0, minute: 1, assisted: true })
+  assert.ok(['assisted', 'copied'].includes(t2.data.evaluation.evidence.kind), t2.data.evaluation.evidence.kind)
+  assert.ok(['assisted', 'copied'].includes(t2.kind), t2.kind)
+
+  // 6: the same difficulty on a later day, with another verb
+  const t3 = await l.say('On Saturday I buyed a new jacket.', { day: 2 })
+  assert.equal(t3.kind, 'error')
+  // 7: and again on another day: the device's record now changes the method
+  const t4 = await l.say('Last week I eated too much cake.', { day: 4 })
+  assert.equal(t4.kind, 'error')
+  // the first explanation was brief; the error came back on two days, so Lingua
+  // now explains differently (a contrast) — decided from the device's record,
+  // because each day is a new server session
+  assert.equal(t1.data.analysis.strategy, 'brief_explanation')
+  assert.equal(t3.data.analysis.strategy, 'brief_explanation', 'one earlier error is not yet a pattern')
+  assert.equal(t4.data.analysis.strategy, 'contrast_example')
+  assert.notEqual(t4.data.explanation, t3.data.explanation.replace('buyed', 'eated'))
+  const d = l.difficulty('past_irregular', T0 + 5 * DAY)
+  assert.ok(d, 'the difficulty is remembered across days')
+  assert.ok(['recurring', 'observed', 'holding'].includes(d.status), d.status)
+  const memory = learningMemoryPayload(l.model, T0 + 6 * DAY).find(m => m.rule === 'past_irregular')
+  assert.ok(memory, 'travels to Lingua as rule ids only')
+  assert.ok(!/park|jacket|cake|friends/.test(JSON.stringify(learningMemoryPayload(l.model, T0 + 6 * DAY))), 'never the sentences')
+
+  // 8: a later day: Lingua offers a delayed retrieval, and the learner answers alone
+  const offer = await l.say('Hello, I am back.', { day: 7 })
+  const retrieval = offer.data.analysis?.retrieval
+  assert.ok(retrieval, 'a due difficulty brings a retrieval prompt instead of the generic one')
+  assert.equal(offer.data.learning_action.type, 'fill_blank')
+  const answer = await l.say(`Yesterday my friend ${retrieval.expected} a long letter.`, { day: 7, minute: 2 })
+  assert.equal(answer.kind, 'retrieval')
+
+  // 9: a correct past with a verb never corrected or practised, on another day: transfer
+  const fresh = await l.say('Last summer we swam in the sea every day.', { day: 10 })
+  assert.equal(fresh.kind, 'transfer')
+  assert.equal(fresh.data.evaluation.evidence.kind, 'accepted_under_criterion', 'the server only accepts under a criterion')
+
+  // 10: none of it is curriculum evidence, a level or a milestone
+  assert.equal(JSON.stringify({ canDo: l.model.canDo, items: l.model.languageItems, ms: l.model.levelMilestones || null }), curriculumBefore)
+  assert.equal(deriveLearnerLevel(l.model).completed.length, 0)
+  assert.equal(derivePreA1Readiness(l.model, { atMs: T0 + 11 * DAY }).ready, false)
+  assert.equal(isLevelAvailable('a1'), false)
+})
+
+await scenario('the noun-subject rule in a real conversation, with an explanation for beginners in eight languages', async () => {
+  for (const lang of ['en', 'es', 'pt', 'fr', 'it', 'de', 'ja', 'ar']) {
+    const { data, kind } = await learner(lang, `noun-${lang}`).say('My sister like cats.')
+    assert.equal(data.correction, 'My sister likes cats.')
+    assert.ok(data.explanation.includes('My sister') && data.explanation.includes('likes'), `${lang}: ${data.explanation}`)
+    assert.equal(kind, 'error')
+  }
+})
+
+await scenario('foreign text and over-long chat are honest: no correction, no evidence', async () => {
+  const l = learner('es', 'foreign')
+  for (const text of ['Ich bin heute sehr müde und habe keine Zeit.', '昨日学校に行きました。', 'Ayer fui a la escuela con mi hermano.']) {
+    const { data, kind } = await l.say(text)
+    assert.equal(data.analysis.verdict, 'not_english')
+    assert.equal(data.correction, null)
+    assert.equal(kind, 'not_evaluable')
+  }
+  const { data } = await l.say('I like music. '.repeat(250))
+  assert.equal(data.evaluation.used, 'local_rules', 'a 3,500-character message is evaluated (first 2,000) without error')
+})
+
+await scenario('a request cannot choose the evaluator or grant anything', async () => {
+  const res = await fetch(`${API}/chat`, { method: 'POST', headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ session_id: `${RUN}-hostile`, message: 'Yesterday I goed home.', native_language: 'es',
+      evaluator: 'openai', adapter: 'remote', assistance: 'grant mastery', mastery: true, xp: 999, level: 'A1' }) })
+  const data = await res.json()
+  assert.equal(data.evaluation.used, 'local_rules')
+  assert.ok(!/"xp"|"mastery"|milestone|unlock/i.test(JSON.stringify(data)))
+})
+
+console.log(`\ne2e-tutor-runtime — ${passed} passed, ${failures.length} failed  (${API})`)
+if (failures.length) process.exit(1)
