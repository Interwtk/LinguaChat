++client = TestClient(app)
++LANGS = list(SUPPORTED)
++SCRIPT = {"ja": re.compile(r"[぀-ヿ一-鿿]"), "ar": re.compile(r"[؀-ۿ]")}
++SPANISH_ONLY = re.compile(r"\b(Escribe|Usa una|Completa|Agrega|Intenta|pasado)\b")
