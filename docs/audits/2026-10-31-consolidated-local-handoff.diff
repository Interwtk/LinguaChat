+/*
+ * P3 — adversarial integrity. More than 1,200 turns, long pauses, and the
+ * edge of the protection window, measured rather than assumed.
+ */
+function withClock(at, fn) {
+  const real = Date.now
+  Date.now = () => at
+  try { return fn() } finally { Date.now = real }
+}
+const MIN = 60 * 1000
