diff -ruN a/linguachat-frontend/scripts/check-ime-enter.mjs b/linguachat-frontend/scripts/check-ime-enter.mjs
--- a/linguachat-frontend/scripts/check-ime-enter.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-ime-enter.mjs	2026-10-31 19:20:53.504381800 -0300
@@ -0,0 +1,82 @@
+#!/usr/bin/env node
+/*
+ * check-ime-enter — Enter sends; Enter that confirms an IME composition does not.
+ *
+ * A Japanese learner types with an input method: Enter picks the kanji/kana.
+ * Every "Enter sends" handler used to fire on that Enter too, sending half a
+ * word (the chat, the answer fields, even the name field). This proves the
+ * shared rule on the event shapes real browsers produce, and that no field
+ * reads Enter on its own any more. The same behaviour is exercised against
+ * the running app in a real browser (see the P2 report, browser results).
+ *
+ * Run: node scripts/check-ime-enter.mjs
+ */
+import assert from 'node:assert/strict'
+import { readFileSync, readdirSync, statSync } from 'node:fs'
+import { join, relative } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { isSubmitEnter } from '../src/services/keyboard.js'
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url))
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+// The shape React hands a handler: its own fields plus the browser event.
+const key = (k, { composing = false, keyCode = k === 'Enter' ? 13 : 0, shift = false } = {}) =>
+  ({ key: k, shiftKey: shift, keyCode, nativeEvent: { key: k, isComposing: composing, keyCode, shiftKey: shift } })
+
+scenario('a plain Enter sends', () => {
+  assert.equal(isSubmitEnter(key('Enter')), true)
+})
+scenario('Enter while composing (Chrome, Firefox, Edge) does not send', () => {
+  assert.equal(isSubmitEnter(key('Enter', { composing: true, keyCode: 229 })), false)
+  assert.equal(isSubmitEnter(key('Enter', { composing: true })), false)
+})
+scenario('the confirming Enter Safari sends after compositionend (keyCode 229) does not send', () => {
+  assert.equal(isSubmitEnter(key('Enter', { composing: false, keyCode: 229 })), false)
+})
+scenario('cancelling a composition (Escape) or typing a key never sends', () => {
+  assert.equal(isSubmitEnter(key('Escape', { composing: true })), false)
+  assert.equal(isSubmitEnter(key('a', { composing: true, keyCode: 229 })), false)
+  assert.equal(isSubmitEnter(key('Escape')), false)
+})
+scenario('the Enter after a finished composition sends normally', () => {
+  // compose → confirm (229) → then a real Enter
+  const sequence = [key('Enter', { composing: true, keyCode: 229 }), key('Enter', { keyCode: 229 }), key('Enter')]
+  assert.deepEqual(sequence.map(e => isSubmitEnter(e)), [false, false, true])
+})
+scenario('the multi-line composer keeps Shift+Enter for a new line; single-line fields may submit', () => {
+  assert.equal(isSubmitEnter(key('Enter', { shift: true })), false)
+  assert.equal(isSubmitEnter(key('Enter', { shift: true }), { allowShift: true }), true)
+  assert.equal(isSubmitEnter(key('Enter', { shift: true, composing: true }), { allowShift: true }), false)
+})
+scenario('a bare DOM KeyboardEvent-like object works too', () => {
+  assert.equal(isSubmitEnter({ key: 'Enter', isComposing: true }), false)
+  assert.equal(isSubmitEnter({ key: 'Enter', isComposing: false, keyCode: 13 }), true)
+  assert.equal(isSubmitEnter(null), false)
+})
+scenario('no field reads Enter on its own: every handler goes through the shared rule', () => {
+  const files = []
+  const walk = dir => {
+    for (const name of readdirSync(dir)) {
+      const path = join(dir, name)
+      if (statSync(path).isDirectory()) walk(path)
+      else if (/\.(jsx?|tsx?)$/.test(name)) files.push(path)
+    }
+  }
+  walk(join(ROOT, 'src'))
+  const raw = files.filter(f => !f.endsWith(join('services', 'keyboard.js')))
+    .filter(f => /key\s*===\s*['"]Enter['"]/.test(readFileSync(f, 'utf8')))
+    .map(f => relative(ROOT, f))
+  assert.deepEqual(raw, [], 'reads Enter directly: ' + raw.join(', '))
+  const users = files.filter(f => readFileSync(f, 'utf8').includes('isSubmitEnter(')).map(f => relative(ROOT, f))
+  for (const expected of ['ConversationRoom.jsx', 'SessionRunner.jsx', 'EpisodeShell.jsx', 'MiniStory.jsx', 'LanguageIdentity.jsx']) {
+    assert.ok(users.some(f => f.endsWith(expected)), expected + ' uses the shared rule')
+  }
+})
+
+console.log(`\ncheck-ime-enter — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
diff -ruN a/linguachat-frontend/scripts/check-learner-level.mjs b/linguachat-frontend/scripts/check-learner-level.mjs
--- a/linguachat-frontend/scripts/check-learner-level.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-learner-level.mjs	2026-10-31 19:20:53.506379700 -0300
@@ -0,0 +1,175 @@
+#!/usr/bin/env node
+/*
+ * check-learner-level — the learner's own level, without opening A1 (P5, block D).
+ *
+ * learnerLevel.deriveLearnerLevel keeps apart: the placement estimate, the
+ * levels the product has open, the level the learner works in, the levels a
+ * VALID milestone completes, and the next level (open or closed). Synthetic
+ * learners play the real Pre-A1 curriculum (scripts/lib/journey.mjs).
+ *
+ * The two-levels-open case runs ONLY in an isolated bench (an explicit
+ * `available` list passed to the function); levels.js is never touched, and
+ * the last group proves A1 is still closed to every path a learner has.
+ *
+ * Run: node scripts/check-learner-level.mjs
+ */
+import assert from 'node:assert/strict'
+import { readFileSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+
+const store = new Map()
+globalThis.localStorage = { getItem: k => (store.has(k) ? store.get(k) : null), setItem: (k, v) => store.set(k, String(v)),
+  removeItem: k => store.delete(k), clear: () => store.clear() }
+
+const { deriveLearnerLevel, workingLevelId } = await import('../src/learning/curriculum/learnerLevel.js')
+const { createLearnerModel, migrateLearnerModel } = await import('../src/learning/engine/learnerModel.js')
+const { reconcileLevelMilestones } = await import('../src/learning/curriculum/graduation.js')
+const { episodesOfLevel, isLevelAvailable, LEVELS, PRE_A1, A1 } = await import('../src/learning/curriculum/levels.js')
+const { episodeRequest } = await import('../src/learning/curriculum/episodeContent.js')
+const { planDay } = await import('../src/learning/engine/planner.js')
+const { playCurriculum, playEpisode, consolidate, STRONG, DAY } = await import('./lib/journey.mjs')
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url))
+const TWO_OPEN = [PRE_A1, A1]     // BENCH ONLY
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+const clone = m => migrateLearnerModel(JSON.parse(JSON.stringify(m)))
+
+const graduate = createLearnerModel()
+const played = playCurriculum(graduate, { profile: STRONG, startMs: Date.now() - 60 * DAY })
+const after = consolidate(graduate, { profile: STRONG, startMs: played.endedAt })
+reconcileLevelMilestones(graduate, { atMs: after.endedAt })
+
+console.log('check-learner-level')
+
+scenario('a new learner: works in Pre-A1, has completed nothing, sees no next level', () => {
+  const l = deriveLearnerLevel(createLearnerModel())
+  assert.equal(l.working, PRE_A1)
+  assert.deepEqual(l.completed, [])
+  assert.equal(l.next, null)
+  assert.equal(l.status, 'in_progress')
+  assert.deepEqual(l.available, [PRE_A1])
+})
+
+scenario('a placement estimate (even A2 or C1) opens nothing and skips nothing', () => {
+  for (const level of ['A2', 'C1', 'pre_a1', 'garbage']) {
+    const l = deriveLearnerLevel(createLearnerModel(), { placement: { level, detectedLevel: level } })
+    assert.equal(l.working, PRE_A1)
+    assert.equal(l.placement.opensNothing, true)
+    assert.equal(l.placement.verified, false)
+  }
+  assert.equal(deriveLearnerLevel(createLearnerModel(), { placement: { level: 'A2' } }).placement.estimate, 'A2')
+  assert.equal(deriveLearnerLevel(createLearnerModel(), { placement: { level: 'garbage' } }).placement.estimate, null)
+})
+
+scenario('a learner cannot write a level: stray fields in the model change nothing', () => {
+  const m = createLearnerModel()
+  Object.assign(m, { level: 'b2', currentLevel: 'a1', workingLevel: 'c2', placement: 'C2' })
+  assert.equal(workingLevelId(m), PRE_A1)
+  assert.deepEqual(deriveLearnerLevel(m).completed, [])
+})
+
+scenario('Pre-A1 in progress', () => {
+  const m = createLearnerModel()
+  const first = episodesOfLevel(PRE_A1).slice(0, 4)
+  let at = Date.now() - 10 * DAY
+  for (const ep of first) { playEpisode(m, ep.id, { profile: STRONG, atMs: at }); at += DAY }
+  const l = deriveLearnerLevel(m)
+  assert.equal(l.working, PRE_A1)
+  assert.equal(l.status, 'in_progress')
+  assert.deepEqual(l.completed, [])
+})
+
+scenario('graduated from Pre-A1 with A1 closed: stays in Pre-A1, the next level is shown as closed', () => {
+  const l = deriveLearnerLevel(graduate)
+  assert.deepEqual(l.completed, [PRE_A1])
+  assert.equal(l.working, PRE_A1, 'nowhere else to work: A1 is closed')
+  assert.equal(l.status, 'graduated')
+  assert.deepEqual(l.next, { id: A1, open: false })
+  assert.equal(l.transition, 'next_level_closed')
+})
+
+scenario('contradictory evidence: an A1 milestone without Pre-A1 is not counted, and is reported', () => {
+  const m = createLearnerModel()
+  m.levelMilestones = { a1: { graduatedAt: '2026-01-01T00:00:00.000Z', evidenceVersion: 'a1.v0-uncalibrated', source: 'evidence' } }
+  const l = deriveLearnerLevel(m)
+  assert.deepEqual(l.completed, [])
+  assert.deepEqual(l.inconsistencies, [{ level: A1, reason: 'earlier_level_not_completed' }])
+  assert.equal(l.working, PRE_A1)
+  // and a graduate whose readiness dropped since (reviews due) is still a graduate
+  const lapsed = clone(graduate)
+  const far = Date.now() + 400 * DAY
+  assert.equal(deriveLearnerLevel(lapsed, { atMs: far }).status, 'graduated')
+})
+
+scenario('an invalid milestone is ignored', () => {
+  for (const bad of [{ pre_a1: { graduatedAt: 'not a date', evidenceVersion: 'pre_a1.v1' } }, { pre_a1: 'yes' },
+    { a1: { graduatedAt: '2026-01-01T00:00:00.000Z', evidenceVersion: 'pre_a1.v1' } }, { b2: { graduatedAt: '2026-01-01T00:00:00.000Z' } }]) {
+    const m = createLearnerModel()
+    m.levelMilestones = bad
+    assert.deepEqual(deriveLearnerLevel(m).completed, [], JSON.stringify(bad))
+  }
+})
+
+scenario('account switch A → B → A and restored progress: derived from each account’s own model', () => {
+  const a = clone(graduate)
+  const b = createLearnerModel()
+  assert.equal(deriveLearnerLevel(a).status, 'graduated')
+  assert.equal(deriveLearnerLevel(b).status, 'in_progress')
+  assert.equal(deriveLearnerLevel(clone(a)).status, 'graduated', 'restored from a backup')
+  assert.deepEqual(deriveLearnerLevel(clone(a)), deriveLearnerLevel(a))
+})
+
+scenario('BENCH, two levels hypothetically open: a graduate works in A1, a non-graduate stays in Pre-A1', () => {
+  const g = deriveLearnerLevel(graduate, { available: TWO_OPEN })
+  assert.equal(g.working, A1)
+  assert.deepEqual(g.next, { id: A1, open: true })
+  assert.equal(g.transition, 'next_level_open')
+  const n = deriveLearnerLevel(createLearnerModel(), { available: TWO_OPEN })
+  assert.equal(n.working, PRE_A1)
+  // the planner, given the graduate's working level, plans A1's first episode
+  const plan = planDay(graduate, episodesOfLevel(g.working))
+  assert.equal(episodesOfLevel(A1)[0].id, plan.episodeId)
+  // an A1 milestone (bench) with Pre-A1 done: both completed, working stays in A1 (nothing above is open)
+  const both = clone(graduate)
+  both.levelMilestones = { ...both.levelMilestones, a1: { graduatedAt: new Date().toISOString(), evidenceVersion: 'a1.v0-uncalibrated', source: 'bench' } }
+  const lb = deriveLearnerLevel(both, { available: TWO_OPEN })
+  assert.deepEqual(lb.completed, [PRE_A1, A1])
+  assert.equal(lb.working, A1)
+  assert.deepEqual(lb.next, { id: 'a2', open: false })
+})
+
+scenario('A1 stays closed: no learner state reaches an A1 episode', () => {
+  assert.equal(isLevelAvailable(A1), false)
+  assert.deepEqual(LEVELS.filter(l => l.available).map(l => l.id), [PRE_A1])
+  for (const m of [createLearnerModel(), graduate, (() => { const x = clone(graduate); x.levelMilestones.a1 = { graduatedAt: new Date().toISOString(), evidenceVersion: 'a1.v0-uncalibrated', source: 'forged' }; return x })()]) {
+    const working = workingLevelId(m)
+    assert.equal(working, PRE_A1)
+    assert.ok(episodesOfLevel(working).every(ep => !episodesOfLevel(A1).some(a => a.id === ep.id)))
+    const plan = planDay(m, episodesOfLevel(working))
+    assert.ok(!plan.episodeId || !episodesOfLevel(A1).some(a => a.id === plan.episodeId))
+  }
+  assert.equal(episodeRequest({ episodeId: episodesOfLevel(A1)[0].id }).reason, 'level_unavailable')
+})
+
+scenario('the screens ask for the learner’s working level, not the first open level', () => {
+  const walk = dir => readdirSync(dir).flatMap(n => statSync(join(dir, n)).isDirectory() ? walk(join(dir, n)) : [join(dir, n)])
+  const users = walk(join(ROOT, 'src')).filter(f => /\.(jsx?|mjs)$/.test(f))
+    .filter(f => /playableLevelId\(/.test(readFileSync(f, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '').replace(/\/\/.*$/gm, '')))
+    .map(f => f.slice(ROOT.length).replace(/\\/g, '/'))
+  // levels.js only DEFINES it; P5 removed the last caller (episodeContent.currentLevelId, unused)
+  assert.deepEqual(users, [])
+  for (const f of ['src/components/today/TodayView.jsx', 'src/components/episode/CompletedEpisodes.jsx', 'src/context/AppContext.jsx',
+    'src/components/layout/JourneyRail.jsx', 'src/components/identity/LearningSummaryCard.jsx', 'src/components/identity/LanguageIdentity.jsx',
+    'src/components/setup/SetupFlow.jsx', 'src/services/placement.js']) {
+    assert.ok(readFileSync(join(ROOT, f), 'utf8').includes('workingLevelId('), f)
+  }
+})
+
+console.log(`\ncheck-learner-level — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
diff -ruN a/linguachat-frontend/scripts/check-learning-loop.mjs b/linguachat-frontend/scripts/check-learning-loop.mjs
--- a/linguachat-frontend/scripts/check-learning-loop.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-learning-loop.mjs	2026-10-31 19:20:53.507383000 -0300
@@ -0,0 +1,170 @@
+#!/usr/bin/env node
+/*
+ * check-learning-loop — one learner, end to end, across days (P2).
+ *
+ * error → the capability it belongs to → an explanation → the same error again
+ * → a dedicated retry block → help (counted as practice, never as ability) →
+ * later independent retrieval fails twice → Lingua switches method → a later,
+ * independent success in a context never used before → the "Tú" summary says
+ * so, and still does not call anything mastered early.
+ *
+ * Every step drives the real engine modules (teaching policy, learner model,
+ * session planner, topic selection, the "Tú" summary). The chat side of the
+ * same loop (goed → went, explanation → contrast → guided retrieval, eight
+ * languages) is the backend test test_full_learning_flow_irregular_past.
+ *
+ * WHAT THIS PROVES: the decisions are wired together and stay honest about
+ * evidence. WHAT IT DOES NOT PROVE: that a real person learns better.
+ *
+ * Run: node scripts/check-learning-loop.mjs
+ */
+import assert from 'node:assert/strict'
+import { observeTeaching, chooseTeaching, skillEvidence } from '../src/learning/engine/teachingPolicy.js'
+import { createLearnerModel, recordItemAttempt, markRecurringError, learningStateOf } from '../src/learning/engine/learnerModel.js'
+import { buildSessionPlan } from '../src/learning/engine/session.js'
+import { selectTopic } from '../src/learning/engine/topicSelection.js'
+import { KNOWN_INTERESTS } from '../src/learning/engine/interests.js'
+import { learnerSummary } from '../src/learning/engine/learnerSummary.js'
+import { derivePreA1Readiness } from '../src/learning/curriculum/readiness.js'
+import { episodesOfLevel, playableLevelId } from '../src/learning/curriculum/levels.js'
+
+const DAY = 86400000
+const START = Date.UTC(2026, 9, 1, 9)
+const ARC = episodesOfLevel(playableLevelId())
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+
+const CAP = 'introduction'
+const ITEM = 'loop:i_am'
+const METHODS = ['concise', 'worked_example']
+function turn(model, day, { instruction, success, independent = true, assisted = false, retried = false, context = 'neutral' }) {
+  const at = START + day * DAY
+  observeTeaching(model, {
+    id: `loop:${day}:${instruction}:${assisted ? 'a' : 'i'}`, capability: CAP, format: 'free_text', session: `day-${day}`,
+    context, at, success, independent, assisted, instruction, channel: 'reading', retried,
+  })
+  recordItemAttempt(model, ITEM, { correct: success, independent: independent && !assisted && !retried, evidenceKind: 'open', atMs: at, capability: CAP })
+  if (!success) markRecurringError(model, 'missing_copula', at)
+}
+
+scenario('the whole loop: error, retry block, help, failed retrievals, method switch, transfer — no early mastery', () => {
+  const m = createLearnerModel()
+  assert.equal(learnerSummary(m, START).empty, true, 'a new learner sees an honest empty state')
+
+  // Day 0 — taught concisely, the first answer misses the verb "to be".
+  turn(m, 0, { instruction: 'concise', success: false })
+  assert.equal(m.recurringErrors[0].errorType, 'missing_copula')
+  const day1Plan = buildSessionPlan(m, ARC, { atMs: START + 1 * DAY })
+  assert.ok(!day1Plan.blocks.some(b => b.type === 'targeted_retry'), 'one slip is not yet a pattern')
+
+  // Day 1 — the same error again, on its own: now it is a pattern.
+  turn(m, 1, { instruction: 'concise', success: false })
+  const day2Plan = buildSessionPlan(m, ARC, { atMs: START + 2 * DAY })
+  const retry = day2Plan.blocks.find(b => b.type === 'targeted_retry')
+  assert.ok(retry, 'a repeated error earns a dedicated retry block')
+  assert.equal(retry.objective, CAP, 'aimed at the capability that failed')
+
+  // Day 2 — with help it goes well. Practice, not ability.
+  turn(m, 2, { instruction: 'concise', success: true, independent: false, assisted: true })
+  assert.equal(skillEvidence(m, CAP, START + 2 * DAY).written.successes, 0, 'a helped answer is not evidence')
+  assert.notEqual(learningStateOf(m, ITEM), 'can_use')
+
+  // Day 3 — later, on their own: still fails. Same method failed twice.
+  turn(m, 3, { instruction: 'concise', success: false })
+  const decision = chooseTeaching(m, CAP, METHODS, 'loop-seed', 'instruction')
+  assert.equal(decision?.reason, 'switch_after_failure', 'two failed later retrievals change the method')
+  assert.equal(decision.format, 'worked_example')
+
+  // Day 4 — taught the other way. Day 6 — on their own, in a new context.
+  turn(m, 4, { instruction: decision.format, success: true, independent: false, assisted: true })
+  turn(m, 6, { instruction: decision.format, success: true, context: 'travel' })
+  const evidence = skillEvidence(m, CAP, START + 6 * DAY)
+  assert.equal(evidence.written.successes, 1)
+  assert.equal(evidence.written.transfer, 1, 'success in a context never used before counts as transfer')
+  assert.notEqual(learningStateOf(m, ITEM), 'can_use', 'one independent success is not "can use"')
+
+  let summary = learnerSummary(m, START + 6 * DAY)
+  assert.equal(summary.empty, false)
+  assert.equal(summary.improved, 1, 'missed before, then done alone on a later day: improvement with evidence')
+  assert.ok(!['holding'].includes(summary.skills.written.status), 'three probes cannot say "holding": ' + summary.skills.written.status)
+  assert.equal(summary.skills.speaking.status, 'not_assessed')
+  assert.equal(summary.skills.pronunciation.status, 'not_assessed')
+  assert.ok(summary.help.assisted >= 2 && summary.help.own >= 1, 'help is shown apart from own answers')
+
+  // Day 9 — again alone, another new context: now the phrase is usable…
+  turn(m, 9, { instruction: decision.format, success: true, context: 'food' })
+  assert.equal(learningStateOf(m, ITEM), 'can_use', 'two independent uses on different days')
+  summary = learnerSummary(m, START + 9 * DAY)
+  assert.equal(summary.words.canUse, 1)
+  // …but four probes, two of them failures, are still not a verdict.
+  assert.equal(summary.skills.written.status, 'uncertain')
+  assert.equal(derivePreA1Readiness(m, { atMs: START + 9 * DAY }).ready, false, 'the level is not declared done')
+  assert.ok(summary.focus, 'a next goal is always offered while not ready')
+})
+
+scenario('help never turns into demonstrated skill, however much of it', () => {
+  const m = createLearnerModel()
+  for (let day = 0; day < 30; day++) turn(m, day, { instruction: 'concise', success: true, independent: false, assisted: true })
+  const summary = learnerSummary(m, START + 30 * DAY)
+  assert.equal(summary.skills.written.successes, 0)
+  assert.equal(summary.skills.written.status, 'insufficient')
+  assert.equal(summary.improved, 0)
+  assert.notEqual(learningStateOf(m, ITEM), 'can_use')
+})
+
+scenario('massed same-day success counts once; "holding" needs several later days', () => {
+  const m = createLearnerModel()
+  turn(m, 0, { instruction: 'concise', success: true, independent: false, assisted: true })
+  for (let i = 0; i < 10; i++) {
+    observeTeaching(m, { id: `mass:${i}`, capability: CAP, format: 'free_text', session: 'day-1', context: 'neutral',
+      at: START + DAY + i * 60000, success: true, independent: true, assisted: false, instruction: 'concise', channel: 'reading', retried: false })
+  }
+  assert.equal(learnerSummary(m, START + 2 * DAY).skills.written.successes, 1, 'ten answers in one sitting are one occasion')
