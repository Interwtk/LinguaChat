diff -ruN a/linguachat-frontend/scripts/check-store-concurrency.mjs b/linguachat-frontend/scripts/check-store-concurrency.mjs
--- a/linguachat-frontend/scripts/check-store-concurrency.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-store-concurrency.mjs	2026-10-31 19:20:53.513815100 -0300
@@ -0,0 +1,207 @@
+#!/usr/bin/env node
+/*
+ * The learner stores that P1 left on one shared key, under two tabs of one
+ * account: missions (history, cursor, rewards), the daily session, the memory
+ * context and the mini-story. Each store has its own semantics, so each is
+ * tested for what it must guarantee rather than with one generic rule.
+ *
+ * A tab reads localStorage from its own cache, which other tabs update late;
+ * `staleView` reproduces that. Everything runs on the real modules and the real
+ * account lease; nothing touches the network.
+ *
+ * Run: node scripts/check-store-concurrency.mjs
+ */
+import assert from 'node:assert/strict'
+import * as missions from '../src/services/missions.js'
+import { applyProgressEvent, commitProgressEvent, loadLocalProgress, recordMissionProgress, saveLocalProgress } from '../src/services/localProgress.js'
+import * as memory from '../src/learning/engine/memoryContext.js'
+import * as story from '../src/learning/engine/miniStory.js'
+import * as sessions from '../src/learning/engine/session.js'
+const { SESSION_KEY, saveSession, loadSession } = sessions
+import { activateLocalAccount } from '../src/auth/browserDataIsolation.js'
+import { captureLearnerAccess } from '../src/auth/localLease.js'
+import { PRACTICE_MISSIONS } from '../src/data/practiceMissions.js'
+
+class Store {
+  constructor() { this.values = new Map() }
+  get length() { return this.values.size }
+  key(i) { return [...this.values.keys()][i] ?? null }
+  getItem(k) { return this.values.has(String(k)) ? this.values.get(String(k)) : null }
+  setItem(k, v) { this.values.set(String(k), String(v)) }
+  removeItem(k) { this.values.delete(String(k)) }
+}
+function staleView(shared) {
+  const frozen = new Map(shared.values)
+  return {
+    get length() { return frozen.size }, key(i) { return [...frozen.keys()][i] ?? null },
+    getItem(k) { return frozen.has(String(k)) ? frozen.get(String(k)) : null },
+    setItem(k, v) { shared.setItem(k, v); frozen.set(String(k), String(v)) },
+    removeItem(k) { shared.removeItem(k); frozen.delete(String(k)) },
+  }
+}
+function openTab(shared, owner) {
+  const session = new Store()
+  globalThis.localStorage = shared; globalThis.sessionStorage = session
+  activateLocalAccount(shared, owner)
+  return {
+    session,
+    act(fn, view = shared) {
+      globalThis.localStorage = view; globalThis.sessionStorage = session
+      try { return fn(captureLearnerAccess(view)) } finally { globalThis.localStorage = shared }
+    },
+  }
+}
+
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+const MISSION = PRACTICE_MISSIONS.find(m => m.steps.length >= 2)
+// The id AppContext gives a mission reward. Before the fix there was none
+// (each React updater drew a random one), which is what `undefined` reproduces.
+const rewardId = (active, part) => missions.missionRewardId?.(active, part)
+const passing = step => ({ passed: true, feedback: 'ok' })
+
+// What AppContext does when a step is answered (and, on the last one, the mission completes).
+function answerStep(tab, active, view) {
+  return tab.act(access => {
+    const details = missions.getActiveMissionDetails(active)
+    const isFinal = active.currentStepIndex === details.totalSteps - 1
+    const advanced = missions.advanceMission(active, details.step, 'answer', passing(details.step), { access, deferSave: isFinal })
+    if (!advanced) return { ok: false }
+    let completed = null
+    if (isFinal) {
+      completed = missions.completeMission(advanced.activeMission, { access })
+      if (!completed) return { ok: false }
+    }
+    let progress = loadLocalProgress()
+    const stepEvent = { mission: details.mission, step: details.step, earnedXp: advanced.earnedThisStep, completed: false,
+      eventId: rewardId(active, `step:${details.step.id}`) }
+    progress = recordMissionProgress(progress, stepEvent)
+    if (completed) progress = recordMissionProgress(progress, { mission: details.mission, step: details.step,
+      earnedXp: Math.max(0, details.mission.rewardXp - completed.earnedXp), completed: true, eventId: rewardId(active, 'complete') })
+    saveLocalProgress(progress, { access })
+    return { ok: true, active: advanced.activeMission, completed }
+  }, view)
+}
+
+console.log('check-store-concurrency')
+
+scenario('missions: the same mission finished in two tabs pays its XP once', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  let active = a.act(access => missions.startMission(MISSION, { access }))
+  for (let i = 0; i < MISSION.steps.length - 1; i++) active = answerStep(a, active).active
+  const view = staleView(shared)                          // b still sees the cursor before a finished
+  const fromA = answerStep(a, active)
+  const fromB = answerStep(b, active, view)
+  assert.equal(fromA.ok, true)
+  void fromB
+  const p = a.act(() => loadLocalProgress())
+  const stepXp = MISSION.steps.reduce((s, step) => s + step.xp, 0)
+  assert.equal(p.missionsCompleted, 1, 'one completion, however many tabs report it')
+  assert.equal(p.xp, Math.max(stepXp, MISSION.rewardXp), 'step XP and the completion bonus are paid once')
+})
+
+scenario('missions: a step answered again by a stale tab pays nothing extra', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const active = a.act(access => missions.startMission(MISSION, { access }))
+  const view = staleView(shared)
+  answerStep(a, active)
+  answerStep(b, active, view)                             // b answers the same first step from a stale cursor
+  const p = a.act(() => loadLocalProgress())
+  assert.equal(p.xp, MISSION.steps[0].xp, 'the first step is paid once')
+})
+
+scenario('missions: two tabs completing different missions keep both history entries', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const [m1, m2] = PRACTICE_MISSIONS.filter(m => m.steps.length >= 1).slice(0, 2)
+  const finish = (tab, mission, view) => {
+    let active = tab.act(access => missions.startMission(mission, { access }), view)
+    for (let i = 0; i < mission.steps.length; i++) {
+      const r = answerStep(tab, active, view)
+      assert.equal(r.ok, true, mission.id + ' step ' + i)
+      active = r.active
+    }
+  }
+  const view = staleView(shared)                          // b's cache stops before a finishes
+  finish(a, m1)
+  finish(b, m2, view)                                     // b never sees a's completion
+  const history = a.act(() => missions.loadCompletedMissions())
+  assert.deepEqual(history.map(h => h.missionId).sort(), [m1.id, m2.id].sort(), 'both completions survive')
+})
+
+scenario('daily session: the bonus of one session is paid once across tabs, even from a stale cache', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const bonus = { id: 'session-bonus:2026-10-30:standard', kind: 'xp', at: Date.now(), xp: 15 }
+  const view = staleView(shared)
+  assert.equal(a.act(access => commitProgressEvent(bonus, { access })), true)
+  assert.equal(b.act(access => commitProgressEvent({ ...bonus, at: Date.now() + 5 }, { access }), view), true)
+  assert.equal(a.act(() => loadLocalProgress()).xp, 15)
+})
+
+scenario('daily session: a stale session write never resurrects a completed day as unfinished', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const base = { version: 1, id: '2026-10-30:standard', dayKey: '2026-10-30', durationMode: 'standard', status: 'active',
+    awarded: false, currentBlockIndex: 0, blocks: [{ id: 'one', type: 'review' }, { id: 'done', type: 'session_completion' }] }
+  a.act(access => saveSession(base, { access }))
+  const stale = staleView(shared)
+  a.act(access => saveSession({ ...base, currentBlockIndex: 1, status: 'completed', awarded: true }, { access }))
+  b.act(access => saveSession({ ...base, currentBlockIndex: 0 }, { access }), stale)
+  const stored = JSON.parse(a.act(access => (sessions.readStoredSessionRaw ? sessions.readStoredSessionRaw(access) : access.getItem(SESSION_KEY))))
+  assert.equal(stored.status, 'completed', 'a completed day stays completed')
+  assert.equal(stored.awarded, true)
+  assert.equal(stored.currentBlockIndex, 1, 'the cursor never moves backwards within a session')
+  void loadSession
+})
+
+scenario('memory context: dismissals made in two tabs are both kept', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const ctxA = a.act(() => memory.loadMemoryContext()), ctxB = b.act(() => memory.loadMemoryContext())
+  a.act(access => memory.dismissTopic('music', { context: ctxA, access }))
+  b.act(access => memory.dismissTopic('games', { context: ctxB, access }))
+  const merged = a.act(() => memory.loadMemoryContext())
+  assert.deepEqual([...merged.dismissedTopicIds].sort(), ['games', 'music'])
+})
+
+scenario('mini-story: a stale tab cannot move the story back', () => {
+  const shared = new Store()
+  const a = openTab(shared, 'A'), b = openTab(shared, 'A')
+  const s = story.getStory('express_like')
+  assert.ok(s, 'a story exists')
+  const initial = story.createStoryState(s, { seed: 'x' })
+  const save = (tab, state) => tab.act(access => (story.saveStoryState
+    ? story.saveStoryState(state, s, { access })
+    : access.setItem(story.STORY_STORAGE_KEY, JSON.stringify(state))))
+  save(a, initial)
+  save(a, story.advanceStory(story.advanceStory(initial, s), s))
+  save(b, initial)                                        // b still holds the first turn
+  const stored = a.act(access => JSON.parse(access.getItem(story.STORY_STORAGE_KEY)))
+  assert.equal(stored.currentTurn, 2, 'the furthest turn is kept')
+})
+
+scenario('A → B → A: a stale A tab writes none of these stores into B', () => {
+  const shared = new Store()
+  const staleA = openTab(shared, 'A')
+  const b = openTab(shared, 'B')
+  const before = b.act(access => [missions.loadCompletedMissions().length, access.getItem('lc2-memory-context-v1')])
+  openTab(shared, 'A')
+  staleA.act(access => {
+    assert.equal(missions.startMission(MISSION, { access }), null, 'the mission start is refused')
+    assert.equal(memory.dismissTopic('music', { access }), null, 'the dismissal is refused')
+    assert.equal(saveSession({ id: 'x' }, { access }), null, 'the session write is refused')
+  })
+  const after = openTab(shared, 'B').act(access => [missions.loadCompletedMissions().length, access.getItem('lc2-memory-context-v1')])
+  assert.deepEqual(after, before, 'B is untouched')
+  void applyProgressEvent
+})
+
+console.log(`\ncheck-store-concurrency — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
diff -ruN a/linguachat-frontend/scripts/check-teaching-decisions.mjs b/linguachat-frontend/scripts/check-teaching-decisions.mjs
--- a/linguachat-frontend/scripts/check-teaching-decisions.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-teaching-decisions.mjs	2026-10-31 19:20:53.514821700 -0300
@@ -0,0 +1,154 @@
+#!/usr/bin/env node
+/*
+ * check-teaching-decisions — every decision Lingua can take, with its reason (P3).
+ *
+ * Each scenario drives the real engine (scaffolding, teaching policy, learner
+ * model, readiness, session planner, chat evidence) and asserts BOTH the
+ * decision and the recorded reason, so a decision can always be explained
+ * from data. It also checks the distinctions difficulty must make: a missing
+ * skill vs an occasional slip, help vs independence, one modality vs another,
+ * not understanding the task vs not knowing the answer, no evidence yet, and
+ * a skill already shown somewhere else — and that taking longer or asking for
+ * help is never treated as failing.
+ *
+ * Run: node scripts/check-teaching-decisions.mjs
+ */
+import assert from 'node:assert/strict'
+import {
+  updateScaffoldAfterTurn, makeScaffoldState, isIndependentEvidence, showsHintByDefault, showsModelAnswer,
+  deriveInitialScaffold, REASONS, EVIDENCE,
+} from '../src/learning/engine/scaffolding.js'
+import { chooseTeaching, skillEvidence, evidenceSummary, observeTeaching } from '../src/learning/engine/teachingPolicy.js'
+import { createLearnerModel, recordItemAttempt, recordCanDoAttempt, getDueReviews } from '../src/learning/engine/learnerModel.js'
+import { buildSessionPlan } from '../src/learning/engine/session.js'
+import { derivePreA1Readiness } from '../src/learning/curriculum/readiness.js'
+import { productiveItemsOf } from '../src/learning/curriculum/preA1Map.js'
+import { episodesOfLevel, playableLevelId } from '../src/learning/curriculum/levels.js'
+
+const DAY = 86400000
+const T0 = Date.UTC(2026, 9, 1, 9)
+const ARC = episodesOfLevel(playableLevelId())
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+const open = { correct: true, evidenceKind: EVIDENCE.OPEN }
+const step = (state, turn) => updateScaffoldAfterTurn(state, turn)
+
+scenario('explain or let them try again: one slip leaves support alone, a second brings help back', () => {
+  let s = makeScaffoldState('low')
+  s = step(s, { correct: false, evidenceKind: EVIDENCE.OPEN })
+  assert.equal(s.currentLevel, 'low', 'an occasional error: try again, nothing taken away')
+  s = step(s, { correct: false, evidenceKind: EVIDENCE.OPEN })
+  assert.equal(s.currentLevel, 'medium', 'the same difficulty twice: more explanation and model')
+  assert.ok(s.reasonCodes.includes(REASONS.RECENT_RETRIES))
+})
+
+scenario('hints and model answers follow the support level', () => {
+  assert.equal(showsHintByDefault('high'), true)
+  assert.equal(showsHintByDefault('low'), false)
+  assert.equal(showsModelAnswer('high'), true)
+  assert.equal(showsModelAnswer('low'), false, 'at low support the learner produces without the answer')
+})
+
+scenario('support is withdrawn on evidence — and using help is not a dead end', () => {
+  let s = makeScaffoldState('high')
+  s = step(s, open); s = step(s, open)
+  assert.equal(s.currentLevel, 'medium')
+  assert.ok(s.reasonCodes.includes(REASONS.RECENT_INDEPENDENT_SUCCESS))
+  let h = makeScaffoldState('medium')
+  // two helped turns: the help is being used, so it stays available…
+  h = step(h, { correct: true, assistanceUsed: true }); h = step(h, { correct: true, assistanceUsed: true })
+  // …four clean helped turns: it has done its job; the learner is asked to try alone
+  for (let i = 0; i < 4; i++) h = step(h, { correct: true, assistanceUsed: true })
+  assert.ok(h.reasonCodes.includes(REASONS.FADED_AFTER_HELPED_SUCCESS), 'help fades after it keeps working')
+})
+
+scenario('help and independence are different evidence', () => {
+  const free = { type: 'free_reply' }
+  assert.equal(isIndependentEvidence({ step: free, assistanceUsed: false, correct: true }), true)
+  assert.equal(isIndependentEvidence({ step: free, assistanceUsed: true, correct: true }), false)
+  assert.equal(isIndependentEvidence({ step: { type: 'choice' }, correct: true }), false, 'recognition is not production')
+})
+
+scenario('a method that keeps failing is changed — by the teaching policy, with the reason', () => {
+  const m = createLearnerModel()
+  const obs = (day, success, instruction, independent = true) => observeTeaching(m, { id: `d${day}`, capability: 'ask_name',
+    format: 'free_text', session: `day-${day}`, context: 'neutral', at: T0 + day * DAY, success, independent, assisted: !independent,
+    instruction, channel: 'reading', retried: false })
+  obs(0, true, 'concise', false); obs(1, false, 'concise'); obs(2, true, 'concise', false); obs(3, false, 'concise')
+  const d = chooseTeaching(m, 'ask_name', ['concise', 'worked_example'], 'seed', 'instruction')
+  assert.equal(d.reason, 'switch_after_failure')
+  assert.equal(d.format, 'worked_example')
+})
+
+scenario('due language comes back as a retrieval activity in the session plan', () => {
+  const m = createLearnerModel()
+  const item = productiveItemsOf(ARC[0].canDoId)[0]
+  recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+  const later = T0 + 30 * DAY
+  assert.ok(getDueReviews(m, later).includes(item), 'scheduled for review')
+  const plan = buildSessionPlan(m, ARC, { atMs: later })
+  assert.ok(plan.blocks.some(b => /review/.test(b.type) && JSON.stringify(b).includes(item)), 'the plan retrieves it')
+})
+
+scenario('enough evidence to move on is a stated threshold, not a feeling', () => {
+  assert.equal(evidenceSummary(2, 0).status, 'insufficient')
+  assert.equal(evidenceSummary(3, 3).status, 'uncertain')
+  assert.equal(evidenceSummary(8, 0).status, 'supported')
+  const fresh = derivePreA1Readiness(createLearnerModel(), { atMs: T0 })
+  assert.equal(fresh.ready, false)
+  assert.ok(fresh.reasonCodes.length > 0, 'and not being ready always says why')
+})
+
+scenario('difficulty: one modality is not the whole skill', () => {
+  const m = createLearnerModel()
+  for (let day = 1; day <= 4; day++) {
+    for (const [channel, success] of [['reading', true], ['listening', false]]) {
+      observeTeaching(m, { id: `${channel}${day}`, capability: 'introduction', format: 'free_text', session: `s${day}-${channel}`,
+        context: 'neutral', at: T0 + day * DAY + (channel === 'listening' ? 1000 : 0), success, independent: true, assisted: false,
+        instruction: 'concise', channel, listening: channel === 'listening', retried: false })
+    }
+  }
+  const e = skillEvidence(m, 'introduction', T0 + 5 * DAY)
+  assert.ok(e.written.successes > 0 && e.written.successes === e.written.samples, 'writing holds')
+  assert.equal(e.listening.successes, 0, 'listening is where the difficulty is')
+  assert.equal(e.speaking.status, 'not_assessed')
+})
+
+scenario('difficulty: not understanding the task gets help at once; taking longer is never a penalty', () => {
+  let s = makeScaffoldState('low')
+  s = step(s, { correct: true, switchedActivity: true })
+  assert.equal(s.currentLevel, 'medium', 'asking for another way brings support on that turn')
+  const a = step(makeScaffoldState('medium'), { ...open, elapsedMs: 5000 })
+  const b = step(makeScaffoldState('medium'), { ...open, elapsedMs: 10 * 60 * 1000 })
+  assert.deepEqual(a, b, 'time spent does not change the decision')
+})
+
+scenario('difficulty: a skill already shown elsewhere starts with less support', () => {
+  const m = createLearnerModel()
+  const canDo = ARC[0].canDoId
+  for (const item of productiveItemsOf(canDo)) {
+    recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+    recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 + DAY })
+  }
+  // shown in another context: a consolidation block of a daily session
+  recordCanDoAttempt(m, canDo, { success: true, independent: true, context: 'session:consolidation', atMs: T0 + DAY })
+  // (items alone, never attempted as the skill, are deliberately NOT enough)
+  const itemsOnly = createLearnerModel()
+  for (const item of productiveItemsOf(canDo)) {
+    recordItemAttempt(itemsOnly, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+    recordItemAttempt(itemsOnly, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 + DAY })
+  }
+  assert.ok(!deriveInitialScaffold({ learnerModel: itemsOnly, targetCanDo: canDo }).reasonCodes.includes(REASONS.TARGET_CAN_USE))
+  const known = deriveInitialScaffold({ learnerModel: m, targetCanDo: canDo, atMs: T0 + 2 * DAY })
+  const unknown = deriveInitialScaffold({ learnerModel: createLearnerModel(), targetCanDo: canDo, atMs: T0 + 2 * DAY })
+  assert.ok(known.reasonCodes.includes(REASONS.TARGET_CAN_USE), known.reasonCodes.join(','))
+  const rank = { high: 0, medium: 1, low: 2 }
+  assert.ok(rank[known.currentLevel] > rank[unknown.currentLevel], `${known.currentLevel} vs ${unknown.currentLevel}`)
+})
+
+console.log(`\ncheck-teaching-decisions — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
diff -ruN a/linguachat-frontend/scripts/check-teaching-intelligence.mjs b/linguachat-frontend/scripts/check-teaching-intelligence.mjs
--- a/linguachat-frontend/scripts/check-teaching-intelligence.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/check-teaching-intelligence.mjs	2026-10-31 19:20:53.515818500 -0300
@@ -0,0 +1,242 @@
+#!/usr/bin/env node
+/*
+ * check-teaching-intelligence — synthetic learners, longitudinal, reproducible.
+ *
+ * Twelve learner profiles drive the real engine (teaching policy, learner
+ * model, scaffolding, copy detection, topic selection, account isolation).
+ * Each profile is replayed with several seeds, capability names and event
+ * orders, so a pass cannot depend on one hand-picked example.
+ *
+ * WHAT THIS PROVES: the engine is internally consistent — strategies change
+ * with evidence, uncertainty follows the amount of evidence, assistance never
+ * becomes mastery, retention and transfer need later and new evidence, topics
+ * vary, accounts stay apart. WHAT IT DOES NOT PROVE: that real people learn
+ * better. That needs a pilot with real learners.
+ *
+ * The chat tutor's corrections and explanations (goed → went, strategy
+ * escalation, eight languages) are checked in the backend suite:
+ * linguachat-backend/tests/test_tutor_intelligence.py.
+ *
+ * Run: node scripts/check-teaching-intelligence.mjs
+ */
+import assert from 'node:assert/strict'
+import { observeTeaching, chooseTeaching, skillEvidence, evidenceSummary, retentionProfile } from '../src/learning/engine/teachingPolicy.js'
+import { createLearnerModel, recordItemAttempt, loadLearnerModel, saveLearnerModel } from '../src/learning/engine/learnerModel.js'
+import { copiesShownModel, isIndependentEvidence, deriveInitialScaffold, updateScaffoldAfterTurn } from '../src/learning/engine/scaffolding.js'
+import { selectTopic } from '../src/learning/engine/topicSelection.js'
+import { KNOWN_INTERESTS } from '../src/learning/engine/interests.js'
+import { activateLocalAccount } from '../src/auth/browserDataIsolation.js'
+import { LEVELS } from '../src/learning/curriculum/levels.js'
+
+const DAY = 86400000
+const START = Date.UTC(2026, 9, 1, 9)
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+function prng(seed) { let x = seed >>> 0; return () => ((x = (x * 1664525 + 1013904223) >>> 0) / 2 ** 32) }
+function shuffled(list, rand) { const out = [...list]; for (let i = out.length - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [out[i], out[j]] = [out[j], out[i]] } return out }
+
+// One practice day: an instruction (worked example or concise) and, on a LATER
+// day, an independent first attempt that tests it. `skill` picks the channel.
+function lesson(model, { capability, day, instruction = 'concise', channel = 'reading', context = 'home' }) {
+  observeTeaching(model, { id: `${capability}:teach:${day}`, capability, format: 'free_reply', session: `d${day}`,
+    at: START + day * DAY, success: null, instruction, channel, context })
+}
+function probe(model, { capability, day, success, channel = 'reading', context = 'home', independent = true, assisted = false, retried = false }) {
+  observeTeaching(model, { id: `${capability}:probe:${day}:${context}`, capability, format: 'free_reply', session: `p${day}`,
+    at: START + day * DAY + 3600000, success, independent, assisted, retried, channel, context,
+    listening: channel === 'listening' ? { firstListenSuccess: success } : null })
+}
+const CAPS = ['introduce_self', 'order_food', 'ask_directions', 'describe_day']
+const SEEDS = [1, 7, 42, 99]
+
+console.log('check-teaching-intelligence')
+
+scenario('1. a beginner starts with full support, and support is withdrawn only by independent success', () => {
+  for (const cap of CAPS) {
+    let state = deriveInitialScaffold({ learnerModel: createLearnerModel(), targetIntent: cap, runMode: 'first_run' })
+    assert.equal(state.currentLevel, 'high', cap + ': a new learner gets the most help')
+    state = updateScaffoldAfterTurn(state, { correct: true, assistanceUsed: true, evidenceKind: 'open' })
+    assert.equal(state.currentLevel, 'high', 'a helped success does not remove help')
+    for (let i = 0; i < 4; i++) state = updateScaffoldAfterTurn(state, { correct: true, assistanceUsed: false, evidenceKind: 'open' })
+    assert.notEqual(state.currentLevel, 'high', 'independent successes withdraw support')
+  }
+})
+
+scenario('2. a fast learner: delayed independent successes make the evidence "supported"', () => {
+  for (const cap of CAPS) {
+    const m = createLearnerModel()
+    for (let d = 0; d < 6; d++) { lesson(m, { capability: cap, day: d * 2 }); probe(m, { capability: cap, day: d * 2 + 1, success: true }) }
+    const written = skillEvidence(m, cap, START + 30 * DAY).written
+    assert.equal(written.status, 'supported', cap)
+    assert.ok(written.mean > 0.8)
+    assert.equal(retentionProfile(m, cap, START + 30 * DAY).priority, -1, 'consistently retained: review can wait')
+  }
+})
+
+scenario('3. repeated errors bring support back (reversible), and the method is switched after two failures', () => {
+  for (const seed of SEEDS) {
+    let state = { ...deriveInitialScaffold({ learnerModel: createLearnerModel(), targetIntent: 'x', runMode: 'first_run' }) }
+    for (let i = 0; i < 6; i++) state = updateScaffoldAfterTurn(state, { correct: true, assistanceUsed: false, evidenceKind: 'open' })
+    const rank = { low: 0, medium: 1, high: 2 }
+    const lowered = state.currentLevel
+    assert.ok(rank[lowered] < rank.high, 'independent work lowered support first')
+    for (let i = 0; i < 3; i++) state = updateScaffoldAfterTurn(state, { correct: false, evidenceKind: 'open', retried: true })
+    assert.ok(rank[state.currentLevel] > rank[lowered], 'support returns after repeated errors')
+    const m = createLearnerModel()
+    for (const d of [0, 2]) { lesson(m, { capability: 'order_food', day: d, instruction: 'concise' }); probe(m, { capability: 'order_food', day: d + 1, success: false }) }
+    const choice = chooseTeaching(m, 'order_food', ['concise', 'worked_example'], String(seed), 'instruction')
+    assert.equal(choice?.reason, 'switch_after_failure')
+    assert.equal(choice.format, 'worked_example', 'the method that failed twice is not chosen again')
+  }
+})
+
+scenario('4. understood with help but not remembered later: no mastery, review comes first', () => {
+  for (const cap of CAPS) {
+    const m = createLearnerModel()
+    for (let d = 0; d < 4; d++) recordItemAttempt(m, cap + ':item', { correct: true, independent: false, atMs: START + d * 1000 })
+    assert.notEqual(m.languageItems[cap + ':item'].learningState, 'can_use', 'helped success is never mastery')
+    for (let d = 0; d < 3; d++) {
+      lesson(m, { capability: cap, day: d * 2, instruction: 'worked_example' })
+      probe(m, { capability: cap, day: d * 2 + 1, success: true, assisted: true, independent: false })
+    }
+    probe(m, { capability: cap, day: 9, success: false })
+    assert.equal(skillEvidence(m, cap, START + 20 * DAY).written.successes, 0, 'assisted successes are not retention evidence')
+    assert.equal(retentionProfile(m, cap, START + 20 * DAY).priority, 2, 'the forgotten capability is reviewed first')
+  }
+})
+
+scenario('5. retained and transferred: success in contexts never seen before counts as transfer', () => {
+  for (const cap of CAPS) {
+    const m = createLearnerModel()
+    const contexts = ['home', 'cafe', 'airport', 'office']
+    contexts.forEach((context, i) => { lesson(m, { capability: cap, day: i * 3, context: 'home' }); probe(m, { capability: cap, day: i * 3 + 2, success: true, context }) })
+    const e = skillEvidence(m, cap, START + 40 * DAY).written
+    assert.equal(e.transfer, 3, 'three new contexts after the first')
+    assert.equal(e.delayed, 4)
+  }
+})
+
+scenario('6. strengths differ by skill: written is not listening, and speaking is never inferred', () => {
+  const m = createLearnerModel()
+  for (let d = 0; d < 5; d++) {
+    lesson(m, { capability: 'order_food', day: d * 4 })
+    probe(m, { capability: 'order_food', day: d * 4 + 1, success: true, channel: 'reading' })
+    probe(m, { capability: 'order_food', day: d * 4 + 2, success: d === 4, channel: 'listening', context: 'audio' + d })
+  }
+  const e = skillEvidence(m, 'order_food', START + 40 * DAY)
+  assert.ok(e.written.mean > e.listening.mean + 0.3, 'written strong, listening weak')
+  assert.equal(e.speaking.status, 'not_assessed')
+  assert.equal(e.pronunciation.status, 'not_assessed')
+})
+
+scenario('7. interests change: topics follow, and topics outside the interests still appear', () => {
+  const before = new Map(), after = new Map(), outside = { before: 0, after: 0 }
+  for (let i = 0; i < 400; i++) {
+    const a = selectTopic({ explicitInterests: ['games', 'music'], seed: 'b' + i })
+    const b = selectTopic({ explicitInterests: ['sports', 'cooking'], seed: 'a' + i })
+    before.set(a.interestId, (before.get(a.interestId) || 0) + 1)
+    after.set(b.interestId, (after.get(b.interestId) || 0) + 1)
+    if (!['games', 'music'].includes(a.interestId)) outside.before++
+    if (!['sports', 'cooking'].includes(b.interestId)) outside.after++
+  }
+  assert.ok((before.get('games') || 0) + (before.get('music') || 0) > 200, 'chosen interests lead')
+  assert.ok((after.get('sports') || 0) + (after.get('cooking') || 0) > 200, 'and the new ones take over when they change')
+  assert.ok((after.get('games') || 0) + (after.get('music') || 0) < 40, 'old interests are not stuck')
+  assert.ok(outside.before >= 40 && outside.after >= 40, 'other topics are not blocked')
+  assert.ok(before.size >= 5 && after.size >= 5, 'variety across contexts')
+  assert.ok(KNOWN_INTERESTS.length > 10)
+})
+
+scenario('8. copying the visible model answer is never independent evidence', () => {
+  const step = { type: 'free_reply', format: 'free_reply' }
+  for (const [reply, shown] of [
+    ["Hi, I'm Ana.", "Hi, I'm Ana."], ["hi im ana", "Hi, I'm Ana!"], ["  HI, I'M ANA ", "Hi, I'm Ana."],
+    ["I would like a coffee, please.", "I would like a coffee, please"], ['Well, I would like a coffee please thanks', 'I would like a coffee, please.'],
+  ]) {
+    assert.equal(copiesShownModel(reply, shown), true, reply)
+    assert.equal(isIndependentEvidence({ step, assistanceUsed: copiesShownModel(reply, shown) }), false)
+  }
+  const m = createLearnerModel()
+  for (let i = 0; i < 5; i++) recordItemAttempt(m, 'coffee', { correct: true, independent: false, atMs: START + i * DAY })
+  assert.notEqual(m.languageItems.coffee.learningState, 'can_use', 'five copies are still not mastery')
+})
+
+scenario('9. a natural variant is the learner’s own production, not a copy', () => {
+  for (const [reply, shown] of [
+    ["Hello! My name is Ana.", "Hi, I'm Ana."], ["Could I get a coffee?", 'I would like a coffee, please.'],
+    ["I'd love a tea", 'I would like a coffee, please.'], ['Ana here, nice to meet you', "Hi, I'm Ana."],
+  ]) assert.equal(copiesShownModel(reply, shown), false, reply)
+})
+
+scenario('10. evidence is per capability, never per interface language', () => {
+  const m = createLearnerModel()
+  for (let d = 0; d < 4; d++) { lesson(m, { capability: 'greet', day: d * 2 }); probe(m, { capability: 'greet', day: d * 2 + 1, success: true }) }
+  const es = skillEvidence(m, 'greet', START + 20 * DAY)
+  // Switching the auxiliary language changes no stored evidence.
+  const after = skillEvidence(JSON.parse(JSON.stringify(m)), 'greet', START + 20 * DAY)
+  assert.deepEqual(after, es)
+})
+
+scenario('11. ambiguous outcomes (unknown verdicts) are neither successes nor failures', () => {
+  const m = createLearnerModel()
+  for (let d = 0; d < 6; d++) { lesson(m, { capability: 'ask', day: d * 2 }); probe(m, { capability: 'ask', day: d * 2 + 1, success: null }) }
+  const e = skillEvidence(m, 'ask', START + 20 * DAY).written
+  assert.equal(e.samples, 0)
+  assert.equal(e.status, 'insufficient', 'no evidence, no claim')
+  assert.equal(chooseTeaching(m, 'ask', ['concise', 'worked_example'], 's', 'instruction'), null)
+})
+
+scenario('12. recent results reverse earlier hypotheses, in any order of arrival', () => {
+  for (const seed of SEEDS) {
+    const rand = prng(seed)
+    const events = []
+    for (let d = 0; d < 6; d++) events.push(['lesson', d * 2], ['probe', d * 2 + 1, true])
+    for (let d = 6; d < 14; d++) events.push(['lesson', d * 2], ['probe', d * 2 + 1, false])
+    const m = createLearnerModel()
+    for (const [kind, day, success] of shuffled(events, rand)) {
+      if (kind === 'lesson') lesson(m, { capability: 'describe_day', day })
+      else probe(m, { capability: 'describe_day', day, success })
+    }
+    const early = skillEvidence(m, 'describe_day', START + 13 * DAY).written
+    const late = skillEvidence(m, 'describe_day', START + 40 * DAY).written
+    assert.ok(early.mean > 0.75, `seed ${seed}: early hypothesis was strong`)
+    assert.ok(late.mean < early.mean, 'later failures lower it')
+    assert.equal(retentionProfile(m, 'describe_day', START + 40 * DAY).priority, 2, 'and send it back to review')
+  }
+})
+
+scenario('uncertainty narrows with evidence and never claims anything from fewer than three', () => {
+  assert.equal(evidenceSummary(2, 0).status, 'insufficient')
+  assert.equal(evidenceSummary(2, 1).status, 'uncertain')
+  const few = evidenceSummary(3, 1), many = evidenceSummary(30, 10)
+  assert.ok(many.high - many.low < few.high - few.low)
+  assert.equal(many.status, 'supported')
+})
+
+scenario('learners of different accounts never see each other’s teaching evidence', () => {
+  class Store { values = new Map(); get length() { return this.values.size } key(i) { return [...this.values.keys()][i] ?? null } getItem(k) { return this.values.get(k) ?? null } setItem(k, v) { this.values.set(k, String(v)) } removeItem(k) { this.values.delete(k) } }
+  const shared = globalThis.localStorage = new Store()
+  globalThis.sessionStorage = new Store()
+  activateLocalAccount(shared, 'A')
+  const a = loadLearnerModel()
+  lesson(a, { capability: 'greet', day: 0 }); probe(a, { capability: 'greet', day: 1, success: true })
+  assert.equal(saveLearnerModel(a, { verified: true }), true)
+  globalThis.sessionStorage = new Store()
+  activateLocalAccount(shared, 'B')
+  assert.equal(loadLearnerModel().teachingHistory?.length || 0, 0, 'B starts with no evidence of A')
+  globalThis.sessionStorage = new Store()
+  activateLocalAccount(shared, 'A')
+  assert.equal(loadLearnerModel().teachingHistory.length, 2, 'A finds its own evidence again')
+  delete globalThis.localStorage; delete globalThis.sessionStorage
+})
+
+scenario('the curriculum gates are unchanged: Pre-A1 open, A1–C2 closed', () => {
+  assert.deepEqual(LEVELS.filter(l => l.available).map(l => l.id), ['pre_a1'])
+})
+
+console.log(`\ncheck-teaching-intelligence — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
