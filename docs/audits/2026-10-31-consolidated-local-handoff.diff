++@pytest.fixture(autouse=True)
++def fresh_memory(monkeypatch):
++    monkeypatch.setenv("LINGUACHAT_PROVIDER", "local")
++    conversation_memory.clear()
++    yield
++    conversation_memory.clear()
++
