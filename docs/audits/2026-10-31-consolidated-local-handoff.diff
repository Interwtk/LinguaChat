++  withClock(start, () => { for (let i = 0; i < 50; i++) { practice(b, 'b ' + i, start + i); persist(b) } })
++  // b is paused (a background tab, a sleeping laptop): it keeps its old memory.
++  for (let i = 0; i < 900; i++) {
