+            ...(Number.isFinite(base.prunedSaved) ? { prunedSaved: Math.max(0, base.prunedSaved) } : {}) } : {}),
+    },
+    events: dedupe(value.events.map(sanitizeEvent).filter(Boolean)),
+  }
+}
+
+export function serializeLedger(ledger) {
+  return { version: PROGRESS_VERSION, epoch: ledger.epoch, base: ledger.base, events: ledger.events }
+}
+
+function canonical(value) { return JSON.stringify(value) }
+
+// One event per id. Should two copies ever disagree about the same id, keep a
+// deterministic one so every tab converges on the same result.
+function dedupe(events) {
+  const byId = new Map()
+  for (const event of events) {
+    const current = byId.get(event.id)
+    if (!current) { byId.set(event.id, event); continue }
+    // P5: the copy that records a durable save wins, and the earliest save of all
+    const a = Number.isFinite(event.saved) ? event.saved : Infinity
+    const b = Number.isFinite(current.saved) ? current.saved : Infinity
+    if (a < b || (a === b && canonical(event) < canonical(current))) byId.set(event.id, event)
+  }
+  return [...byId.values()].sort(byTime)
+}
+
+/*
+ * Per writer, exactly which events were folded: the sequence range
+ * [min, max] minus `holes` (numbers inside the range not folded yet — only
+ * when a writer's clock disagreed with its own order, a backdated turn). No
+ * time is involved, and the range does not need to start at 1 (after a reset
+ * a tab's sequence simply continues).
+ */
+const HOLES_LIMIT = 64
+function sanitizeCoverage(raw) {
+  const out = {}
+  for (const [w, entry] of Object.entries(raw)) {
+    const { min, max, at } = entry || {}
+    if (!WRITER_ID.test(w) || !Number.isInteger(min) || !Number.isInteger(max) || min < 1 || max < min || !Number.isFinite(at)) continue
+    const holes = Array.isArray(entry.holes)
+      ? [...new Set(entry.holes.filter(n => Number.isInteger(n) && n > min && n < max))].sort((x, y) => x - y).slice(0, HOLES_LIMIT) : []
+    const saved = Number.isFinite(entry.saved) ? { saved: entry.saved } : {}
+    out[w] = holes.length ? { min, max, at, ...saved, holes } : { min, max, at, ...saved }
+  }
+  return out
+}
+
+const coverageHas = (entry, seq) => Boolean(entry) && seq >= entry.min && seq <= entry.max && !entry.holes?.includes(seq)
+
+/* The entry once `event` is folded too — or null if that would scatter it beyond HOLES_LIMIT. */
+function coverageAdd(entry, event) {
+  const n = event.seq
+  const latestSave = Math.max(Number.isFinite(entry?.saved) ? entry.saved : -Infinity, Number.isFinite(event.saved) ? event.saved : -Infinity)
+  const saved = Number.isFinite(latestSave) ? { saved: latestSave } : {}
+  if (!entry) return { min: n, max: n, at: event.at, ...saved }
+  const holes = new Set(entry.holes || [])
+  let { min, max } = entry
+  if (n > max) { for (let k = max + 1; k < n; k++) holes.add(k); max = n }
+  else if (n < min) { for (let k = n + 1; k < min; k++) holes.add(k); min = n }
+  else holes.delete(n)
+  if (holes.size > HOLES_LIMIT) return null
+  const out = { min, max, at: Math.max(entry.at, event.at), ...saved }
+  if (holes.size) out.holes = [...holes].sort((x, y) => x - y)
+  return out
+}
+
+const hasIdentity = event => typeof event.w === 'string' && Number.isInteger(event.seq)
+
+/*
+ * Is this event already counted in `base`? By identity when both sides have
+ * one; by time for events and bases from before P4.
+ */
+export function isCovered(base, event) {
+  if (!base) return false
+  if (hasIdentity(event) && base.coverage) {
+    const entry = base.coverage[event.w]
+    if (entry) return coverageHas(entry, event.seq)
+    if (event.at > (base.prunedBefore || 0)) return false
+    // P5: first saved after every pruned writer's last folded save → never folded
+    if (Number.isFinite(event.saved) && Number.isFinite(base.prunedSaved)) return event.saved <= base.prunedSaved
+    return true
+  }
+  return event.at < (base.foldedBefore || 0)
+}
+
+/*
+ * A base that does not contain everything another one folded. Both cannot be
+ * kept (the folded events are gone), so this is reported, not hidden: tests
+ * assert it never happens under the conditions they cover (see the P4 report).
+ */
+export const ledgerDiagnostics = { baseConflicts: 0 }
+function noteConflict(chosen, other) {
+  if (!chosen.coverage || !other.coverage) return
+  for (const [w, entry] of Object.entries(other.coverage)) {
+    const mine = chosen.coverage[w]
+    const lost = !mine ? entry.at > (chosen.prunedBefore || 0)
+      : entry.min < mine.min || entry.max > mine.max || (mine.holes || []).some(n => coverageHas(entry, n))
+    if (lost) { ledgerDiagnostics.baseConflicts++; return }
+  }
+}
+
+const newerEpoch = (a, b) => (a.at !== b.at ? (a.at > b.at ? a : b) : (a.id >= b.id ? a : b))
+
+function preferredBase(a, b) {
+  const chosen = choose(a, b)
+  noteConflict(chosen, chosen === a ? b : a)
+  return chosen
+}
+function choose(a, b) {
+  if (a.foldedBefore !== b.foldedBefore) return a.foldedBefore > b.foldedBefore ? a : b
+  if (a.folded !== b.folded) return a.folded > b.folded ? a : b
+  return canonical(a) <= canonical(b) ? a : b
+}
+
+/*
+ * The union of two copies. Commutative, associative and idempotent, so it does
+ * not matter which tab merges or how often.
+ */
+export function mergeLedgers(a, b) {
+  if (!a) return b
+  if (!b) return a
+  const epoch = newerEpoch(a.epoch, b.epoch)
+  const sameEpoch = [a, b].filter(l => l.epoch.id === epoch.id && l.epoch.at === epoch.at)
+  const preferred = sameEpoch.map(l => l.base).reduce(preferredBase)
+  // A reward folded in either copy stays counted, whichever base is kept:
+  // the union of remembered ids and the higher floor of each family.
+  const floors = {}
+  for (const l of sameEpoch) {
+    for (const [name, floor] of Object.entries(l.base.foldedFloors || {})) if (!floors[name] || floor > floors[name]) floors[name] = floor
+  }
+  const base = { ...preferred, ...pruneFolded(sameEpoch.flatMap(l => l.base.foldedIds || []), floors) }
+  const events = dedupe([...a.events, ...b.events])
+    .filter(event => event.at >= epoch.at && !isCovered(base, event) && !isFoldedReward(base, event.id))
+  return { epoch: { ...epoch }, base, events }
+}
+
+export function hasEvent(ledger, id) {
+  return Boolean(ledger?.events.some(event => event.id === id))
+}
+
+export function addEvent(ledger, raw) {
+  const event = sanitizeEvent(raw)
+  if (!event) throw new Error('Invalid progress event')
+  if (hasEvent(ledger, event.id)) return ledger
+  // An event from before a reset or already folded into the base cannot be
+  // added again; it was either erased by the learner or already counted.
+  if (event.at < ledger.epoch.at || isCovered(ledger.base, event)) return ledger
+  if (isFoldedReward(ledger.base, event.id)) return ledger
+  return { ...ledger, events: dedupe([...ledger.events, event]) }
+}
+
+/*
+ * Fold old events into the base so the ledger stays bounded. Only events older
+ * than the horizon (or beyond the size cap) are folded; a copy still holding
+ * one of them later will see it as already counted.
+ */
+export function compactLedger(ledger, now = Date.now()) {
+  const events = [...ledger.events].sort(byTime)
+  let cutoff = now - LEDGER_HORIZON_MS
+  if (events.length > LEDGER_MAX_EVENTS) {
+    cutoff = Math.max(cutoff, Math.min(events[events.length - LEDGER_MAX_EVENTS].at, now - LEDGER_SETTLE_MS))
+  }
+  /*
+   * Below the cut by time. For events with an identity, coverage records
+   * exactly which ones were folded, so it can never claim an event that was
+   * not folded, whatever order the clock gave them.
+   */
+  const folding = new Set()
+  const byWriter = new Map()
+  for (const event of events) {
+    if (!hasIdentity(event)) { if (event.at < cutoff) folding.add(event); continue }
+    if (!byWriter.has(event.w)) byWriter.set(event.w, [])
+    byWriter.get(event.w).push(event)
+  }
+  const coverage = { ...(ledger.base.coverage || {}) }
+  for (const [w, list] of byWriter) {
+    list.sort((x, y) => x.seq - y.seq)
+    for (const event of list) {
+      if (event.at >= cutoff) continue
+      const next = coverageAdd(coverage[w], event)
+      if (!next) continue                    // too scattered for now: it stays an event, folded later
+      coverage[w] = next
+      folding.add(event)
+    }
+  }
+  const remaining = events.filter(event => !folding.has(event))
+  // forget writers that cannot matter any more (see COVERAGE_KEEP_MS)
+  let prunedBefore = ledger.base.prunedBefore || 0
+  let prunedSaved = Number.isFinite(ledger.base.prunedSaved) ? ledger.base.prunedSaved : 0
+  const pending = new Set(remaining.filter(hasIdentity).map(event => event.w))
+  for (const [w, entry] of Object.entries(coverage)) {
+    if (entry.at < now - COVERAGE_KEEP_MS && !pending.has(w)) {
+      prunedBefore = Math.max(prunedBefore, entry.at)
+      // an entry folded by older code has no save times: assume everything up to now
+      prunedSaved = Math.max(prunedSaved, Number.isFinite(entry.saved) ? entry.saved : now)
+      delete coverage[w]
+    }
+  }
+  const coverageChanged = JSON.stringify(coverage) !== JSON.stringify(ledger.base.coverage || {})
+  if (!folding.size && !coverageChanged && ledger.base.coverage) return ledger
+  const folded = [...folding].sort(byTime)
+  return {
+    ...ledger,
+    base: {
+      ...ledger.base,
+      snapshot: foldEvents(ledger.base.snapshot, folded),
+      foldedBefore: folded.length ? Math.max(ledger.base.foldedBefore, cutoff) : ledger.base.foldedBefore,
+      folded: ledger.base.folded + folded.length,
+      ...pruneFolded([...(ledger.base.foldedIds || []), ...folded.map(e => e.id).filter(isStableEventId)],
+        ledger.base.foldedFloors || {}),
+      coverage,
+      prunedBefore,
+      prunedSaved,
+    },
+    events: remaining,
+  }
+}
+
+/*
+ * Stamp `writer`'s own events that have never been saved with the time of this
+ * save attempt (P5). Called on the ledger about to be written: if the write
+ * fails, nothing is stored and the next attempt stamps again; once a write
+ * succeeds, the stamped copy in storage wins every merge (dedupe), so the time
+ * is fixed from then on.
+ */
+export function stampUnsaved(ledger, writer, now = Date.now()) {
+  if (!ledger || !writer) return ledger
+  let changed = false
+  const events = ledger.events.map(event => {
+    if (event.w !== writer || !hasIdentity(event) || Number.isFinite(event.saved)) return event
+    changed = true
+    return { ...event, saved: now }
+  })
+  return changed ? { ...ledger, events } : ledger
+}
+
+export function deriveSnapshot(ledger) {
+  return foldEvents(ledger.base.snapshot, ledger.events)
+}
+
+export function sameLedger(a, b) {
+  return canonical(a) === canonical(b)
+}
diff -ruN a/linguachat-frontend/src/services/storageQuarantine.js b/linguachat-frontend/src/services/storageQuarantine.js
--- a/linguachat-frontend/src/services/storageQuarantine.js	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/src/services/storageQuarantine.js	2026-10-31 19:20:53.534817200 -0300
@@ -0,0 +1,46 @@
+/*
+ * Unreadable learner data is set aside, never silently overwritten.
+ *
+ * When a stored value cannot be parsed or validated, the app must still be
+ * able to move on — but the original bytes may be the only copy of somebody's
+ * progress. Before anything replaces such a value, its exact bytes are copied
+ * to an account-scoped quarantine key named after a hash of the content, so a
+ * repeated attempt is idempotent and two different corruptions never collide.
+ *
+ * The copy goes through the same captured account lease as every other learner
+ * write: it can never land in another account's storage. If the copy cannot be
+ * made, the caller must not overwrite the original.
+ */
+export const QUARANTINE_PREFIX = 'lc2-quarantine:'
+
+// FNV-1a, 32 bit: a stable short name for the content, not a security hash.
+function contentHash(text) {
+  let hash = 0x811c9dc5
+  for (let i = 0; i < text.length; i++) {
+    hash ^= text.charCodeAt(i)
+    hash = Math.imul(hash, 0x01000193) >>> 0
+  }
+  return hash.toString(16).padStart(8, '0')
+}
+
+export function quarantineKey(key, raw) {
+  return `${QUARANTINE_PREFIX}${key}:${contentHash(String(raw))}:${String(raw).length}`
+}
+
+/*
+ * Copy `raw` (the value currently stored under `key`) aside. Returns the
+ * quarantine key on success and null when the copy could not be verified.
+ */
+export function quarantineValue(access, key, raw, reason = 'unreadable') {
+  if (raw === null || raw === undefined) return null
+  const target = quarantineKey(key, raw)
+  const record = JSON.stringify({ key, reason, raw: String(raw) })
+  try {
+    if (!access.valid()) return null
+    if (access.getItem(target) === record) return target
+    if (access.setItem(target, record) === false || !access.valid()) return null
+    return access.getItem(target) === record && access.valid() ? target : null
+  } catch {
+    return null
+  }
+}
diff -ruN a/linguachat-frontend/src/services/writerKeys.js b/linguachat-frontend/src/services/writerKeys.js
--- a/linguachat-frontend/src/services/writerKeys.js	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/src/services/writerKeys.js	2026-10-31 19:20:53.535816400 -0300
@@ -0,0 +1,134 @@
+/*
+ * One storage key per writer.
+ *
+ * Browsers keep a per-tab cache of localStorage and update it from other tabs
+ * asynchronously. While a tab is busy it cannot see another tab's latest
+ * write, so read–merge–write on a shared key can still overwrite that write —
+ * reproduced in two real tabs: one tab's 300 verified saves all vanished.
+ *
+ * So no tab ever rewrites a key another tab writes. Each page load writes its
+ * own copy under `<base>~w~<writer>`; readers merge every copy (the merge is a
+ * union, so extra copies are harmless).
+ *
+ * Cleaning up — and why it cannot lose data. Each page holds a Web Lock named
+ * after its writer id for as long as it is open; the browser releases it when
+ * the tab closes or is discarded. Another tab removes a copy only when
+ *   1. its writer's lock is NOT held (that page is gone and can never write
+ *      again — no timer, no guess), and
+ *   2. everything in it is already in this tab's own verified copy, and
+ *   3. it still holds exactly the bytes that were checked.
+ * Where Web Locks are unavailable nothing is removed: data is kept and growth
+ * is reported instead of risked. (P1 used "idle for two minutes", which could
+ * race with an idle tab that was still open.)
+ *
+ * Keys keep the `lc2-` prefix, so they live in the account's namespace and
+ * move with the account exactly like every other learner key.
+ */
+export const WRITER_SEPARATOR = '~w~'
+const TAB_KEY = 'lc2-writer-tab'
+
+function randomId() {
+  if (globalThis.crypto?.randomUUID) return globalThis.crypto.randomUUID().slice(0, 13)
+  return `${Date.now().toString(36)}${Math.random().toString(36).slice(2, 8)}`
+}
+
+// Distinct per page load (a duplicated tab copies sessionStorage, not this).
+const PAGE = randomId()
+// Without a usable sessionStorage the id must still be stable for this page.
+const NO_SESSION_TAB = 'tab'
+
+/* This tab's writer id: the tab's session id plus this page load. */
+export function writerId() {
+  let tab = null
+  try {
+    const session = globalThis.sessionStorage
+    if (session) {
+      tab = session.getItem(TAB_KEY)
+      if (!tab) { tab = randomId(); session.setItem(TAB_KEY, tab) }
+      if (session.getItem(TAB_KEY) !== tab) tab = null
+    }
+  } catch { tab = null }
+  return `${tab || NO_SESSION_TAB}.${PAGE}`
+}
+
+export function ownKey(base) {
+  const id = writerId()
+  holdWriterLock(id)
+  return `${base}${WRITER_SEPARATOR}${id}`
+}
+
+const LOCK_PREFIX = 'lc2-writer:'
+const heldIds = new Set()
+
+/* Hold this page's liveness lock until the page goes away. */
+export function holdWriterLock(id = writerId()) {
+  const locks = globalThis.navigator?.locks
+  if (heldIds.has(id) || typeof locks?.request !== 'function') return
+  heldIds.add(id)
+  try {
+    locks.request(LOCK_PREFIX + id, () => new Promise(() => {})).catch(() => heldIds.delete(id))
+  } catch { heldIds.delete(id) }
+}
+
+/* Writer ids whose page is still open, or null when the browser cannot say. */
+export async function liveWriterIds() {
+  const locks = globalThis.navigator?.locks
+  if (typeof locks?.query !== 'function') return null
+  try {
+    const { held = [], pending = [] } = await locks.query()
+    return new Set([...held, ...pending].map(lock => lock?.name).filter(name => name?.startsWith(LOCK_PREFIX))
+      .map(name => name.slice(LOCK_PREFIX.length)))
+  } catch { return null }
+}
+
+let collections = Promise.resolve()
+/* Resolves when every clean-up started so far has finished (tests, shutdown). */
+export const settleCollections = () => collections
+
+/*
+ * Remove copies of `base` left by closed pages that add nothing to this tab's
+ * own copy (`addsNothing(parsed, raw)` decides, per store). Never throws;
+ * resolves to the number of copies removed.
+ */
+export function collectDeadCopies(access, base, addsNothing) {
+  // Fixed now, not when the clean-up runs: "this tab's copy" must never be
+  // re-derived from whatever context is current later.
+  const own = ownKey(base)
+  const run = collections.then(async () => {
+    const live = await liveWriterIds()
+    if (!live) return 0
+    let removed = 0
+    for (const copy of storedCopies(access, base)) {
+      if (copy.key === own) continue
+      const writer = copy.key === base ? null : copy.key.slice(base.length + WRITER_SEPARATOR.length)
+      if (writer && live.has(writer)) continue
+      let parsed
+      try { parsed = JSON.parse(copy.raw) } catch { continue }
+      try { if (!addsNothing(parsed, copy.raw)) continue } catch { continue }
+      if (!access.valid() || access.getItem(copy.key) !== copy.raw) continue
+      access.removeItem(copy.key)
+      removed++
+    }
+    return removed
+  }).catch(() => 0)
+  collections = run
+  return run
+}
+
+export function isWriterKey(base, key) {
+  return key === base || (typeof key === 'string' && key.startsWith(base + WRITER_SEPARATOR))
+}
+
+/* Every stored copy of `base`: the shared (older) key and each writer's key. */
+export function storedCopies(access, base) {
+  const keys = typeof access.keys === 'function' ? access.keys() : []
+  // This tab's own copy is always read, even where keys cannot be listed.
+  const names = [...new Set([base, ownKey(base), ...keys.filter(key => isWriterKey(base, key))])]
+  const copies = []
+  for (const key of names) {
+    const raw = access.getItem(key)
+    if (raw !== null && raw !== undefined) copies.push({ key, raw })
+  }
+  return copies
+}
+
