+"""P5, block C: an adversarial corpus for the rules added in P5 — and the old ones.
+
+* MUST_FLAG: natural learner errors the rules now see, each with its exact span
+  and replacement (noun subjects, the same after a time phrase or a reporting
+  verb, "don't" after a noun, past markers with a noun subject).
+* MUST_NOT_FLAG: constructions chosen because a naive agreement rule trips on
+  them — plurals, collectives, irregular plurals, compound subjects, questions,
+  bare infinitives (let/see/help/make), the mandative subjunctive, compound
+  nouns, commas, relative clauses, imperatives after a time phrase, names.
+  A wrong correction is worse than a missed one: these must stay untouched.
+* KNOWN_MISSES: real errors the rules deliberately do not touch, listed so the
+  limit is visible. They must still never be praised or accepted.
+* LANGUAGE: clearly foreign text is not English; English with foreign names,
+  borrowed words or very short text is not called foreign.
+
+Printed at the end (pytest -s): precision and recall on this corpus. It is a
+corpus written by the developer, not real learner data.
+"""
+import pytest
+
+from ai.evaluator_adapters import reference_result
+from ai.evaluator_contract import EvaluatorRequest
+from ai.grammar_check import analyze
+from ai.language_id import identify
+
+MUST_FLAG = [
+    ("My sister like cats.", [("third_person", "like", "likes")]),
+    ("My brother play football every Sunday.", [("third_person", "play", "plays")]),
+    ("Our teacher speak very slowly.", [("third_person", "speak", "speaks")]),
+    ("This phone have a good camera.", [("third_person", "have", "has")]),
+    ("My best friend live in Rome.", [("third_person", "live", "lives")]),
+    ("The shop open at nine.", [("third_person", "open", "opens")]),
+    ("Her son work in a bank.", [("third_person", "work", "works")]),
+    ("My dog always sleep on the sofa.", [("third_person", "sleep", "sleeps")]),
+    ("When my mother cook, I help her.", [("third_person", "cook", "cooks")]),
+    ("I think my sister like cats.", [("third_person", "like", "likes")]),
+    ("My sister don't like cats.", [("third_person", "don't", "doesn't")]),
+    ("Every child need love.", [("third_person", "need", "needs")]),
+    ("The play start at eight.", [("third_person", "start", "starts")]),
+    ("My mother's friend like jazz.", [("third_person", "like", "likes")]),
+    ("Every morning my father drink coffee.", [("third_person", "drink", "drinks")]),
+    ("I know this teacher speak French.", [("third_person", "speak", "speaks")]),
+    ("My cat like fish, and my dog like meat.", [("third_person", "like", "likes"), ("third_person", "like", "likes")]),
+    ("Yesterday my sister go to the park.", [("past_marker", "go", "went")]),
+    ("Last week the shop is closed.", [("past_marker", "is", "was")]),
+    ("Two days ago, my uncle buy a car.", [("past_marker", "buy", "bought")]),
+    ("Last summer my cousin visit London.", [("past_marker", "visit", "visited")]),
+    ("She like music.", [("third_person", "like", "likes")]),
+    ("Yesterday I goed to school.", [("past_irregular", "goed", "went")]),
+    ("I have a apple.", [("article", "a", "an")]),
+]
+
+MUST_NOT_FLAG = [
+    # plural and collective subjects
+    "My sisters like cats.", "My parents live in Lima.", "The children play outside.", "People like music.",
+    "The police want to talk to you.", "My family live in Lima.", "The team play well this year.",
+    "The sheep eat grass.", "Our friends work in a hotel.", "The news make me sad.", "His glasses look new.",
+    # compound subjects
+    "My sister and I like cats.", "My sister and brother play tennis.", "My mother and my father cook dinner.",
+    "My mother or my father cook dinner.",
+    # questions and auxiliaries
+    "Does my sister like cats?", "Can my brother come?", "Will the shop open tomorrow?", "Why does your dog bark?",
+    "My sister can swim.", "My sister will come later.", "My sister doesn't like cats.", "My sister likes cats.",
+    # bare infinitives and the subjunctive
+    "Let my sister go.", "I saw my sister go out.", "I helped my mother cook dinner.", "I made my dog sit.",
+    "I heard the baby cry.", "It is important that my brother go.", "We suggest that the student wait.",
+    # compound nouns, commas, relative clauses
+    "The school work is hard.", "My home work is done.", "My sister, like me, loves cats.",
+    "The man I like is tall.", "The book my sister reads is long.", "The woman who lives here is kind.",
+    "The car that my father drives is red.",
+    # time phrases and imperatives
+    "This week go to bed early!", "Every day eat some fruit.", "Each morning take your medicine.",
+    "Yesterday my sister read a book.", "Last night the baby slept well.", "Yesterday my brother was ill.",
+    # names and capitals
+    "Maria likes cats.", "The Beatles play rock.", "The United States have many states.",
+    # other valid sentences that share words with the rules
+    "My favourite food is pizza.", "The weather is nice today.", "This is my sister.", "That shop sells bread.",
+    "My best friend lives in Rome.", "The first step is easy.", "Every child needs love.", "Each student has a book.",
+    "My dog always sleeps on the sofa.", "When my mother cooks, I help her.", "I think my sister likes cats.",
+    "My brother plays football.", "Our teacher speaks slowly.", "Notwithstanding the drizzle, we ambled along the quay.",
+]
+
+KNOWN_MISSES = [
+    "Maria like cats.",                  # proper names are not checked
+    "The bus arrive at eight.",          # head ends in -s: left alone
+    "My other sister like cats.",        # "other" blocks the phrase
+    "Each of them like pizza.",          # "of" ends the phrase
+    "The book my sister like is long.",  # relative clause
+    "Everybody like music.",             # indefinite pronoun
+    "I like dogs and my sister like cats.",  # "and" without a comma: could be a compound subject
+    "The little girl with the hat like dogs.",  # long noun phrase
+]
+
+FOREIGN = [
+    ("Ayer fui a la escuela con mi hermano.", "es"), ("Hola, yo quiero un café con leche, por favor.", "es"),
+    ("Mi hermana tiene un perro muy grande.", "es"), ("Eu fui à escola ontem com o meu irmão.", "pt"),
+    ("Je suis très content, merci pour le café.", "fr"), ("Hier je suis allé à l'école avec mon frère.", "fr"),
+    ("Ieri sono andato a scuola con mio fratello.", "it"), ("Ich bin heute sehr müde und habe keine Zeit.", "de"),
+    ("Gestern bin ich mit meinem Bruder in die Schule gegangen.", "de"),
+    ("昨日学校に行きました。", "ja"), ("ذهبت إلى المدرسة أمس مع أخي.", "ar"), ("어제 학교에 갔어요.", "ko"),
+    ("Вчера я ходил в школу.", "ru"),
+]
+ENGLISH_WITH_FOREIGN_BITS = [
+    "My name is Juan de la Cruz.", "We went to Los Angeles and San Francisco.", "I love paella con mariscos.",
+    "I studied at the Universidad de la Habana.", "Bon appétit, everyone!", "She said ciao and left.",
+    "I want to learn German because my friend lives in Berlin.", "The café is near the station.",
+]
+SHORT = ["Hola", "ok", "Danke!", "si", "Merci beaucoup"]
+
+
+def flagged(text):
+    return sorted((f.rule, f.original, f.replacement) for f in analyze(text))
+
+
+@pytest.mark.parametrize("text,expected", MUST_FLAG)
+def test_flags_the_error_exactly(text, expected):
+    assert flagged(text) == sorted(expected)
+
+
+@pytest.mark.parametrize("text", MUST_NOT_FLAG)
+def test_leaves_valid_and_ambiguous_constructions_alone(text):
+    assert flagged(text) == []
+
+
+@pytest.mark.parametrize("text", KNOWN_MISSES)
+def test_known_misses_are_never_praised(text):
+    assert flagged(text) == []
+    result = reference_result(EvaluatorRequest(learner_language="es", level="pre_a1", capability="free_conversation",
+                                               objective="free conversation in English", response_text=text))
+    assert result.certainty == "unsure" and result.evidence.kind in {"insufficient", "not_evaluable"}
+
+
+@pytest.mark.parametrize("text,code", FOREIGN)
+def test_foreign_text_is_not_english(text, code):
+    guess = identify(text)
+    assert guess.english is False and guess.language == code
+
+
+@pytest.mark.parametrize("text", ENGLISH_WITH_FOREIGN_BITS + [t for t in MUST_NOT_FLAG if "drizzle" not in t])
+def test_english_with_foreign_names_stays_english(text):
+    assert identify(text).english is not False
+
+
+@pytest.mark.parametrize("text", SHORT)
+def test_short_text_is_not_claimed(text):
+    assert identify(text).language is None
+
+
+@pytest.mark.parametrize("lang", ["en", "es", "pt", "fr", "it", "de", "ja", "ar"])
+def test_noun_subject_explanations_are_localized_short_and_valid(lang):
+    request = EvaluatorRequest(learner_language=lang, level="pre_a1", capability="free_conversation",
+                               objective="free conversation in English", response_text="My sister like cats.")
+    result = reference_result(request)                 # validated: language, length, no manipulation
+    assert "My sister" in result.explanation and "likes" in result.explanation
+    assert len(result.explanation) <= 220
+
+
+def test_corpus_precision_and_recall(capsys):
+    expected = {t: sorted(e) for t, e in MUST_FLAG}
+    tp = sum(1 for t, e in expected.items() if flagged(t) == e)
+    fp = sum(1 for t in MUST_NOT_FLAG + [f for f, _ in FOREIGN if not identify(f).english is False] if flagged(t))
+    errors = len(MUST_FLAG) + len(KNOWN_MISSES)
+    with capsys.disabled():
+        print(f"\n  adversarial corpus: {tp}/{len(MUST_FLAG)} errors flagged exactly; {len(KNOWN_MISSES)} known misses; "
+              f"recall {tp / errors:.2f}; false positives {fp}/{len(MUST_NOT_FLAG)}")
+    assert fp == 0 and tp == len(MUST_FLAG)
diff -ruN a/linguachat-backend/tests/test_learning_memory.py b/linguachat-backend/tests/test_learning_memory.py
--- a/linguachat-backend/tests/test_learning_memory.py	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-backend/tests/test_learning_memory.py	2026-10-31 19:20:53.491373600 -0300
@@ -0,0 +1,139 @@
+"""P3: the chat's side of pedagogical continuity.
+
+The server forgets a conversation after a few turns. The learner's device keeps
+a compact record (rule ids, a status, verbs already practised — never
+sentences) and sends it with each turn. These tests prove the server uses it
+only in the narrow ways it should, validates it, and reports correct uses as
+observations rather than verdicts.
+"""
+import pytest
+from fastapi.testclient import TestClient
+
+from ai.grammar_check import correct_uses
+from ai.local_engine import assess, choose_strategy
+from ai.tutor_i18n import MESSAGES
+from app.routes.chat import _safe_learning_memory
+from app.services.memory import conversation_memory
+from main import app
+
+client = TestClient(app)
+
+
+@pytest.fixture(autouse=True)
+def fresh_memory(monkeypatch):
+    monkeypatch.setenv("LINGUACHAT_PROVIDER", "local")
+    conversation_memory.clear()
+    yield
+    conversation_memory.clear()
+
+
+def chat(message, *, session="m", memory=None, lang="es"):
+    payload = {"session_id": session, "message": message, "level": "A1", "native_language": lang}
+    if memory is not None:
+        payload["learning_memory"] = memory
+    response = client.post("/chat", json=payload)
+    assert response.status_code == 200
+    return response.json()
+
+
+# --- correct uses are observations, and only unambiguous ones ----------------
+
+@pytest.mark.parametrize("sentence, forms", [
+    ("Yesterday I went to the park and ate pizza.", ["went", "ate"]),
+    ("Last week we took the train and wrote postcards.", ["took", "wrote"]),
+    ("I have eaten already.", []),            # participle, not the simple past
+    ("The cake was made by my mother.", []),  # passive
+    ("I left the keys on the left.", []),     # "left" is also a direction
+    ("I put it there yesterday.", []),        # same form as the base
+    ("Did you go?", []),                      # "did" is an auxiliary here
+    ("Yesterday I goed to school.", []),      # an error is not a use
+    ("I go to school.", []),
+])
+def test_correct_uses_are_unambiguous(sentence, forms):
+    assert [u["form"] for u in correct_uses(sentence)] == forms
+    assert all(u["rule"] == "past_irregular" for u in correct_uses(sentence))
+
+
+def test_a_correct_sentence_is_still_not_a_verdict():
+    result = assess("Yesterday I went to the park.")
+    assert result["verdict"] == "no_issue_detected" and result["confidence"] == "low"
+    assert result["uses"] == [{"rule": "past_irregular", "form": "went", "base": "go"}]
+
+
+# --- the memory is validated, closed-set, sentence-free ----------------------
+
+def test_memory_keeps_only_known_rules_and_closed_fields():
+    raw = [
+        {"rule": "past_irregular", "status": "recurring", "due": True, "bases": ["go", "eat", "Yesterday I goed"],
+         "preferred_strategy": "contrast_example", "transcript": "Yesterday I goed to school"},
+        {"rule": "past_irregular", "status": "observed"},                 # duplicate rule
+        {"rule": "drop_tables", "due": True},                             # unknown rule
+        {"rule": "article", "status": "mastered", "due": "yes"},          # not a status; not a bool
+        "free text",
+    ] + [{"rule": "third_person"}] * 20
+    safe = _safe_learning_memory(raw)
+    assert safe == [
+        {"rule": "past_irregular", "due": True, "status": "recurring", "preferred_strategy": "contrast_example",
+         "bases": ["go", "eat"]},
+        {"rule": "article", "due": False},
+        {"rule": "third_person", "due": False},
+    ]
+    assert _safe_learning_memory("nope") == [] and _safe_learning_memory(None) == []
+
+
+# --- strategy across days ------------------------------------------------------
+
+def test_a_recurring_difficulty_starts_with_contrast_on_a_new_day():
+    fresh = chat("Yesterday I buyed bread.", session="day2-none")
+    assert fresh["analysis"]["strategy"] == "brief_explanation", "no memory: the light touch"
+    remembered = chat("Yesterday I buyed bread.", session="day2-mem",
+                      memory=[{"rule": "past_irregular", "status": "recurring"}])
+    assert remembered["analysis"]["strategy"] == "contrast_example"
+
+
+def test_the_policys_choice_is_used_but_the_conversation_wins():
+    memory = [{"rule": "past_irregular", "status": "recurring", "preferred_strategy": "guided_retrieval"}]
+    first = chat("Yesterday I runned home.", session="pol", memory=memory)
+    assert first["analysis"]["strategy"] == "guided_retrieval"
+    assert first["learning_action"]["type"] == "fill_blank"
+    # in-session escalation is unchanged by memory for other rules
+    assert choose_strategy("article", {"learning_memory": memory}) == "brief_explanation"
+
+
+# --- delayed retrieval in a new context ---------------------------------------
+
+def test_a_due_difficulty_gets_one_retrieval_in_a_new_sentence():
+    memory = [{"rule": "past_irregular", "status": "recurring", "due": True, "bases": ["go", "write", "swim"]}]
+    data = chat("I like my new job.", session="due", memory=memory)
+    action = data["learning_action"]
+    assert action["type"] == "fill_blank"
+    retrieval = data["analysis"]["retrieval"]
+    assert retrieval["rule"] == "past_irregular"
+    assert retrieval["base"] not in {"go", "write", "swim"}, "a verb not practised before"
+    assert action["expected"] == retrieval["expected"] == {"eat": "ate"}[retrieval["base"]]
+    assert "____" in action["prompt"] and "earlier day" not in action["prompt"], "the lead follows the learner's language"
+    assert data["correction"] is None
+
+
+def test_no_retrieval_when_nothing_is_due_or_on_top_of_a_correction():
+    not_due = chat("I like my new job.", session="nd", memory=[{"rule": "past_irregular", "due": False}])
+    assert "retrieval" not in (not_due["analysis"] or {})
+    on_error = chat("Yesterday I goed home.", session="oe", memory=[{"rule": "article", "due": True}])
+    assert "retrieval" not in on_error["analysis"]
+    assert on_error["analysis"]["findings"][0]["rule"] == "past_irregular"
+
+
+@pytest.mark.parametrize("rule, expected_by_base", [
+    ("third_person", {"work": "works"}),
+    ("article", {"orange": "an"}),
+    ("past_marker", {"work": "worked"}),
+])
+def test_every_remembered_rule_can_be_retrieved(rule, expected_by_base):
+    data = chat("I like my new job.", session="r-" + rule, memory=[{"rule": rule, "due": True}])
+    retrieval = data["analysis"]["retrieval"]
+    assert retrieval["rule"] == rule
+    assert expected_by_base[retrieval["base"]] == retrieval["expected"]
+
+
+def test_the_retrieval_lead_exists_in_all_eight_languages():
+    assert set(MESSAGES["retrieval_lead"]) == {"en", "es", "pt", "fr", "it", "de", "ja", "ar"}
diff -ruN a/linguachat-backend/tests/test_tutor_intelligence.py b/linguachat-backend/tests/test_tutor_intelligence.py
--- a/linguachat-backend/tests/test_tutor_intelligence.py	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-backend/tests/test_tutor_intelligence.py	2026-10-31 19:20:53.492372600 -0300
@@ -0,0 +1,256 @@
+"""The local tutor: corrections, explanations, strategy and language.
+
+Synthetic learners, replayed with many verbs, sentences and languages so a pass
+cannot depend on one hand-written example. These tests prove the engine is
+consistent and honest about its limits; they do not prove that real learners
+learn better (that needs a pilot).
+"""
+import re
+
+import pytest
+from fastapi.testclient import TestClient
+
+from ai.grammar_check import IRREGULAR_PAST, analyze, corrected_sentence
+from ai.tutor_i18n import MESSAGES, SUPPORTED, resolve_language
+from app.services.memory import conversation_memory
+from main import app
+
+client = TestClient(app)
+LANGS = list(SUPPORTED)
+SCRIPT = {"ja": re.compile(r"[぀-ヿ一-鿿]"), "ar": re.compile(r"[؀-ۿ]")}
+SPANISH_ONLY = re.compile(r"\b(Escribe|Usa una|Completa|Agrega|Intenta|pasado)\b")
+
+
+@pytest.fixture(autouse=True)
+def fresh_memory(monkeypatch):
+    monkeypatch.setenv("LINGUACHAT_PROVIDER", "local")
+    conversation_memory.clear()
+    yield
+    conversation_memory.clear()
+
+
+def chat(message, *, lang="es", level="A1", session="s", **extra):
+    response = client.post("/chat", json={"session_id": session, "message": message, "level": level,
+                                          "native_language": lang, **extra})
+    assert response.status_code == 200
+    return response.json()
+
+
+# --- the mandatory case -------------------------------------------------------
+
+def test_yesterday_i_goed_to_school():
+    data = chat("Yesterday I goed to school.")
+    assert data["mode"] == "correction"
+    assert data["correction"] == "Yesterday I went to school."
+    assert "went" in data["explanation"] and "go" in data["explanation"] and "goed" in data["explanation"]
+    assert "irregular" in data["explanation"]
+    assert data["analysis"]["verdict"] == "error"
+    assert data["analysis"]["findings"][0]["rule"] == "past_irregular"
+
+
+# --- generalisation, not a list of sentences ----------------------------------
+
+WRONG_PASTS = {
+    "eated": "ate", "buyed": "bought", "thinked": "thought", "catched": "caught", "teached": "taught",
+    "writed": "wrote", "drived": "drove", "swimmed": "swam", "runned": "ran", "sleeped": "slept",
+    "bringed": "brought", "payed": "paid", "sayed": "said", "goed": "went", "wented": "went",
+    "speaked": "spoke", "taked": "took", "maked": "made", "comed": "came", "knowed": "knew",
+}
+
+
+@pytest.mark.parametrize("wrong,past", sorted(WRONG_PASTS.items()))
+@pytest.mark.parametrize("frame", ["Yesterday I {} a lot.", "We {} together last night.", "She {} it two days ago."])
+def test_every_irregular_past_mistake_is_corrected(wrong, past, frame):
+    findings = analyze(frame.format(wrong))
+    assert [f.rule for f in findings][:1] == ["past_irregular"]
+    assert findings[0].replacement == past
+    assert corrected_sentence(frame.format(wrong), findings) == frame.format(past)
+
+
+@pytest.mark.parametrize("sentence,expected", [
+    ("Yesterday I go to the park.", "Yesterday I went to the park."),
+    ("Last week we visit my grandma.", "Last week we visited my grandma."),
+    ("Two days ago they are very tired.", "Two days ago they were very tired."),
+    ("She like music.", "She likes music."),
+    ("He watch TV every day.", "He watches TV every day."),
+    ("My sister eat an banana.", None),
+    ("I have a orange.", "I have an orange."),
+    ("It is an university.", "It is a university."),
+])
+def test_other_rules(sentence, expected):
+    findings = analyze(sentence)
+    assert findings, sentence
+    if expected:
+        assert corrected_sentence(sentence, findings) == expected
+
+
+# --- no false negatives on natural, valid English ----------------------------
+
+VALID = [
+    "Yesterday I went to school.", "I went to school yesterday.", "We ate pizza last night.",
+    "She likes music.", "Does she like music?", "He doesn't like coffee.", "Let it go.",
+    "I have an apple.", "It is a university.", "I waited an hour.", "They were tired two days ago.",
+    "I seed the soil every spring.", "Can she swim?", "I want to go home.", "My friends play football.",
+    "Last week I visited my grandma.", "I didn't go to school yesterday.", "Did you eat breakfast?",
+    "He has a car.", "We usually walk to work.", "She can drive.", "It works now.",
+    "I'm happy today.", "How are you?", "I would like a coffee, please.", "They study English.",
+    "An honest answer is best.", "I bought a new phone.", "He wrote a letter.", "We swam in the lake.",
+]
+
+
+@pytest.mark.parametrize("sentence", VALID)
+def test_valid_sentences_get_no_correction(sentence):
+    assert analyze(sentence) == []
+    data = chat(sentence, session="valid-" + str(abs(hash(sentence))))
+    assert data["correction"] is None
+    # No rule fired: that is NOT a verdict of correctness, and it is never sold as one.
+    assert data["analysis"]["verdict"] in {"no_issue_detected", "insufficient"}
+    assert data["analysis"]["confidence"] in {"low", "high"}
+    assert not re.search(r"\b(correct|perfect|no mistakes)\b", data["reply"], re.I)
+
+
+# --- strategy changes when an explanation does not work ----------------------
+
+def test_strategy_escalates_then_recovers():
+    seen = []
+    for message in ["Yesterday I goed to school.", "Last week I eated pizza.", "Yesterday we runned home."]:
+        data = chat(message, session="escalate")
+        seen.append(data["analysis"]["strategy"])
+    assert seen == ["brief_explanation", "contrast_example", "guided_retrieval"]
+    last = data
+    assert last["learning_action"]["type"] == "fill_blank"
+    assert last["learning_action"]["expected"] == "ran"
+    # Retrieval in a NEW sentence: neither the learner's nor the corrected one.
+    assert "We ran home" not in last["learning_action"]["prompt"]
+    assert "____" in last["learning_action"]["prompt"]
+    assert "✗" in last["explanation"], "the contrast stays available"
+    # Once the error stops recurring, the window clears and the light touch returns.
+    for i in range(8):
+        chat("I like my school.", session="escalate")
+    assert chat("Yesterday I buyed bread.", session="escalate")["analysis"]["strategy"] == "brief_explanation"
+
+
+def test_a_detailed_preference_starts_with_contrast():
+    data = chat("She like music.", session="pref", tutor_preferences={"explanation_depth": "detailed"})
+    assert data["analysis"]["strategy"] == "contrast_example"
+
+
+def test_the_level_shapes_the_reply_not_the_correction():
+    a1 = chat("Yesterday I goed to school.", level="A1", session="lv1")
+    c1 = chat("Yesterday I goed to school.", level="C1", session="lv2")
+    assert a1["correction"] == c1["correction"] == "Yesterday I went to school."
+    assert a1["reply"] != c1["reply"]
+
+
+# --- the learner's language, explicitly --------------------------------------
+
+@pytest.mark.parametrize("lang", LANGS)
+def test_explanations_follow_the_learner_language(lang):
+    data = chat("Yesterday I goed to school.", lang=lang, session="lang-" + lang)
+    assert data["analysis"]["language"] == lang
+    text = " ".join(str(data[k] or "") for k in ("explanation", "suggestion", "focus")) + data["learning_action"]["prompt"]
+    assert "went" in data["explanation"], "the English form itself is never translated"
+    if lang in SCRIPT:
+        assert SCRIPT[lang].search(text), f"{lang} text is in its own script"
+    if lang != "es":
+        assert not SPANISH_ONLY.search(text), f"no Spanish leaks into {lang}"
+    assert data["reply"].startswith("Almost!"), "Lingua's own line stays in English, the practised language"
+
+
+def test_switching_language_mid_session():
+    es = chat("Yesterday I goed to school.", lang="es", session="switch")
+    ja = chat("Last week I eated pizza.", lang="ja", session="switch")
+    assert es["analysis"]["language"] == "es" and ja["analysis"]["language"] == "ja"
+    assert SCRIPT["ja"].search(ja["explanation"]) and not SPANISH_ONLY.search(ja["explanation"])
+
+
+def test_unsupported_language_is_english_and_says_so():
+    assert resolve_language("ko") == ("en", False)
+    assert resolve_language({"code": "ar-EG", "base": "ar"}) == ("ar", True)
+    data = chat("Yesterday I goed to school.", lang="ko", session="ko")
+    assert data["analysis"]["language"] == "en"
+
+
+def test_every_message_exists_in_all_eight_languages():
+    for key, table in MESSAGES.items():
+        assert set(table) == set(SUPPORTED), key
+        placeholders = set(re.findall(r"{(\w+)}", table["en"]))
+        for lang, text in table.items():
+            assert set(re.findall(r"{(\w+)}", text)) == placeholders, (key, lang)
+
+
+def test_a_message_in_the_learners_own_language_is_noticed():
+    for lang, message in [("es", "hola quiero aprender ingles"), ("ja", "こんにちは、英語を勉強したい"),
+                          ("ar", "مرحبا أريد أن أتعلم"), ("fr", "je ne sais pas comment le dire")]:
+        data = chat(message, lang=lang, session="own-" + lang)
+        assert data["analysis"]["verdict"] == "not_english", lang
+        assert data["correction"] is None
+
+
+# --- ambiguity and missing information --------------------------------------
+
+@pytest.mark.parametrize("message", ["ok", "???", "school", "...", "x"])
+def test_too_little_to_judge_is_said_plainly(message):
+    data = chat(message, session="amb-" + message)
+    assert data["correction"] is None
+    assert data["analysis"]["verdict"] == "insufficient"
+
+
+def test_typing_back_the_correction_is_not_praised_as_mastery():
+    chat("Yesterday I goed to school.", session="copy")
+    data = chat("Yesterday I went to school.", session="copy")
+    assert data["correction"] is None
+    assert data["analysis"]["verdict"] == "no_issue_detected"
+    assert data["analysis"]["confidence"] == "low"
+
+
+# --- one tutor ----------------------------------------------------------------
+
+@pytest.mark.parametrize("companion", ["lingo", "chatto", "Chatto", "LINGO", None])
+def test_only_lingua_answers(companion):
+    payload = {"active_companion": companion} if companion else {}
+    data = chat("Yesterday I goed to school.", session="who", **payload)
+    text = " ".join(str(data.get(k) or "") for k in ("reply", "explanation", "suggestion", "focus"))
+    assert "Lingo" not in text and "Chatto" not in text
+    assert chat("who are you", session="who2", **payload)["reply"].startswith("I'm Lingua")
+
+
+def test_memory_keeps_rule_ids_not_words():
+    chat("Yesterday I goed to school.", session="priv")
+    stored = conversation_memory.get("priv")[-1]
+    assert stored["error_types"] == ["past_irregular"]
+    assert conversation_memory.recent_error_types("priv") == ["past_irregular"]
+
+
+# --- the whole loop, one learner (P2) ----------------------------------------
+
+def test_full_learning_flow_irregular_past():
+    """Error → explanation → the same error again → another strategy → retrieval
+    in a new sentence → a correct answer on their own → later, a new context.
+    At no point is a correct sentence praised as mastery of the rule."""
+    first = chat("Yesterday I goed to the park.", session="loop")
+    assert first["analysis"]["findings"][0]["rule"] == "past_irregular"
+    assert first["analysis"]["strategy"] == "brief_explanation"
+    assert first["correction"] == "Yesterday I went to the park."
+
+    again = chat("Last night I eated pasta.", session="loop")
+    assert again["analysis"]["strategy"] == "contrast_example", "the explanation did not work: change it"
+    assert "✗" in again["explanation"]
+
+    third = chat("Last week we buyed a car.", session="loop")
+    assert third["analysis"]["strategy"] == "guided_retrieval", "stop explaining, ask for retrieval"
+    action = third["learning_action"]
+    assert action["type"] == "fill_blank" and action["expected"] == "bought"
+    assert "We bought a car" not in action["prompt"], "retrieval happens in a new sentence"
+
+    own = chat("Last weekend we bought some bread.", session="loop")
+    assert own["correction"] is None
+    assert own["analysis"]["verdict"] == "no_issue_detected"
+    assert own["analysis"]["confidence"] == "low", "silence from a few rules is not mastery"
+
+    # Later, a different context, without the memory of the earlier errors.
+    later = chat("Last summer I swam in the sea and ate fish.", session="loop-later")
+    assert later["correction"] is None
+    assert later["analysis"]["confidence"] == "low"
+    relapse = chat("Yesterday I runned to work.", session="loop-later")
+    assert relapse["analysis"]["strategy"] == "brief_explanation", "a fresh slip starts light again"
diff -ruN a/linguachat-frontend/bench/fakeAppContext.jsx b/linguachat-frontend/bench/fakeAppContext.jsx
--- a/linguachat-frontend/bench/fakeAppContext.jsx	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/bench/fakeAppContext.jsx	2026-10-31 19:20:53.493381900 -0300
@@ -0,0 +1,31 @@
+/*
+ * The synthetic `useApp()` the visual bench gives every component (see
+ * vite.bench.config.mjs). Development only; never imported by the product.
+ *
+ * Each scene wraps its components in <AppProvider value={…}> with the few
+ * values it needs. Anything a component asks for that a scene did not set is
+ * a no-op function (for actions such as setX/onX/navigateTo) or undefined —
+ * nothing here signs in, stores or sends anything.
+ */
+import { createContext, useContext } from 'react'
+
+const Ctx = createContext({})
+const noop = () => {}
+const ACTION = /^(set|on|toggle|start|begin|navigate|select|submit|abandon|use|update|save|reset|logout|login|signup|send|resend|change|request|complete|record|dismiss|clear|open|close|finish|retry|mark)/
+
+export function AppProvider({ value, children }) {
+  return <Ctx.Provider value={value}>{children}</Ctx.Provider>
+}
+
+export const useApp = () => {
+  const value = useContext(Ctx)
+  return new Proxy(value, {
+    get(target, prop) {
+      if (prop in target) return target[prop]
+      if (typeof prop === 'string' && ACTION.test(prop)) return noop
+      return undefined
+    },
+  })
+}
+
+export default AppProvider
