++  assert.match(css, /\.bubble-user \{[\s\S]*?color: var\(--on-accent\)/, 'so does the learner’s bubble')
++})
++
++console.log(`\ncheck-archive-honesty — ${passed} passed, ${failures.length} failed`)
++if (failures.length) process.exit(1)
