+    uses, seen = [], set()
+    for i, word in enumerate(words):
+        base = PAST_TO_BASE.get(word)
+        if not base or word in seen:
+            continue
+        if any(w in PARTICIPLE_CONTEXT for w in words[max(0, i - 2):i]):
+            continue
+        seen.add(word)
+        uses.append({"rule": "past_irregular", "form": word, "base": base})
+    return uses
