+#!/usr/bin/env node
+/*
+ * check-teaching-decisions — every decision Lingua can take, with its reason (P3).
+ *
+ * Each scenario drives the real engine (scaffolding, teaching policy, learner
+ * model, readiness, session planner, chat evidence) and asserts BOTH the
+ * decision and the recorded reason, so a decision can always be explained
+ * from data. It also checks the distinctions difficulty must make: a missing
+ * skill vs an occasional slip, help vs independence, one modality vs another,
+ * not understanding the task vs not knowing the answer, no evidence yet, and
+ * a skill already shown somewhere else — and that taking longer or asking for
+ * help is never treated as failing.
+ *
+ * Run: node scripts/check-teaching-decisions.mjs
+ */
+import assert from 'node:assert/strict'
+import {
+  updateScaffoldAfterTurn, makeScaffoldState, isIndependentEvidence, showsHintByDefault, showsModelAnswer,
+  deriveInitialScaffold, REASONS, EVIDENCE,
+} from '../src/learning/engine/scaffolding.js'
+import { chooseTeaching, skillEvidence, evidenceSummary, observeTeaching } from '../src/learning/engine/teachingPolicy.js'
+import { createLearnerModel, recordItemAttempt, recordCanDoAttempt, getDueReviews } from '../src/learning/engine/learnerModel.js'
+import { buildSessionPlan } from '../src/learning/engine/session.js'
+import { derivePreA1Readiness } from '../src/learning/curriculum/readiness.js'
+import { productiveItemsOf } from '../src/learning/curriculum/preA1Map.js'
+import { episodesOfLevel, playableLevelId } from '../src/learning/curriculum/levels.js'
+
+const DAY = 86400000
+const T0 = Date.UTC(2026, 9, 1, 9)
+const ARC = episodesOfLevel(playableLevelId())
+let passed = 0
+const failures = []
+function scenario(name, run) {
+  try { run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+const open = { correct: true, evidenceKind: EVIDENCE.OPEN }
+const step = (state, turn) => updateScaffoldAfterTurn(state, turn)
+
+scenario('explain or let them try again: one slip leaves support alone, a second brings help back', () => {
+  let s = makeScaffoldState('low')
+  s = step(s, { correct: false, evidenceKind: EVIDENCE.OPEN })
+  assert.equal(s.currentLevel, 'low', 'an occasional error: try again, nothing taken away')
+  s = step(s, { correct: false, evidenceKind: EVIDENCE.OPEN })
+  assert.equal(s.currentLevel, 'medium', 'the same difficulty twice: more explanation and model')
+  assert.ok(s.reasonCodes.includes(REASONS.RECENT_RETRIES))
+})
+
+scenario('hints and model answers follow the support level', () => {
+  assert.equal(showsHintByDefault('high'), true)
+  assert.equal(showsHintByDefault('low'), false)
+  assert.equal(showsModelAnswer('high'), true)
+  assert.equal(showsModelAnswer('low'), false, 'at low support the learner produces without the answer')
+})
+
+scenario('support is withdrawn on evidence — and using help is not a dead end', () => {
+  let s = makeScaffoldState('high')
+  s = step(s, open); s = step(s, open)
+  assert.equal(s.currentLevel, 'medium')
+  assert.ok(s.reasonCodes.includes(REASONS.RECENT_INDEPENDENT_SUCCESS))
+  let h = makeScaffoldState('medium')
+  // two helped turns: the help is being used, so it stays available…
+  h = step(h, { correct: true, assistanceUsed: true }); h = step(h, { correct: true, assistanceUsed: true })
+  // …four clean helped turns: it has done its job; the learner is asked to try alone
+  for (let i = 0; i < 4; i++) h = step(h, { correct: true, assistanceUsed: true })
+  assert.ok(h.reasonCodes.includes(REASONS.FADED_AFTER_HELPED_SUCCESS), 'help fades after it keeps working')
+})
+
+scenario('help and independence are different evidence', () => {
+  const free = { type: 'free_reply' }
+  assert.equal(isIndependentEvidence({ step: free, assistanceUsed: false, correct: true }), true)
+  assert.equal(isIndependentEvidence({ step: free, assistanceUsed: true, correct: true }), false)
+  assert.equal(isIndependentEvidence({ step: { type: 'choice' }, correct: true }), false, 'recognition is not production')
+})
+
+scenario('a method that keeps failing is changed — by the teaching policy, with the reason', () => {
+  const m = createLearnerModel()
+  const obs = (day, success, instruction, independent = true) => observeTeaching(m, { id: `d${day}`, capability: 'ask_name',
+    format: 'free_text', session: `day-${day}`, context: 'neutral', at: T0 + day * DAY, success, independent, assisted: !independent,
+    instruction, channel: 'reading', retried: false })
+  obs(0, true, 'concise', false); obs(1, false, 'concise'); obs(2, true, 'concise', false); obs(3, false, 'concise')
+  const d = chooseTeaching(m, 'ask_name', ['concise', 'worked_example'], 'seed', 'instruction')
+  assert.equal(d.reason, 'switch_after_failure')
+  assert.equal(d.format, 'worked_example')
+})
+
+scenario('due language comes back as a retrieval activity in the session plan', () => {
+  const m = createLearnerModel()
+  const item = productiveItemsOf(ARC[0].canDoId)[0]
+  recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+  const later = T0 + 30 * DAY
+  assert.ok(getDueReviews(m, later).includes(item), 'scheduled for review')
+  const plan = buildSessionPlan(m, ARC, { atMs: later })
+  assert.ok(plan.blocks.some(b => /review/.test(b.type) && JSON.stringify(b).includes(item)), 'the plan retrieves it')
+})
+
+scenario('enough evidence to move on is a stated threshold, not a feeling', () => {
+  assert.equal(evidenceSummary(2, 0).status, 'insufficient')
+  assert.equal(evidenceSummary(3, 3).status, 'uncertain')
+  assert.equal(evidenceSummary(8, 0).status, 'supported')
+  const fresh = derivePreA1Readiness(createLearnerModel(), { atMs: T0 })
+  assert.equal(fresh.ready, false)
+  assert.ok(fresh.reasonCodes.length > 0, 'and not being ready always says why')
+})
+
+scenario('difficulty: one modality is not the whole skill', () => {
+  const m = createLearnerModel()
+  for (let day = 1; day <= 4; day++) {
+    for (const [channel, success] of [['reading', true], ['listening', false]]) {
+      observeTeaching(m, { id: `${channel}${day}`, capability: 'introduction', format: 'free_text', session: `s${day}-${channel}`,
+        context: 'neutral', at: T0 + day * DAY + (channel === 'listening' ? 1000 : 0), success, independent: true, assisted: false,
+        instruction: 'concise', channel, listening: channel === 'listening', retried: false })
+    }
+  }
+  const e = skillEvidence(m, 'introduction', T0 + 5 * DAY)
+  assert.ok(e.written.successes > 0 && e.written.successes === e.written.samples, 'writing holds')
+  assert.equal(e.listening.successes, 0, 'listening is where the difficulty is')
+  assert.equal(e.speaking.status, 'not_assessed')
+})
+
+scenario('difficulty: not understanding the task gets help at once; taking longer is never a penalty', () => {
+  let s = makeScaffoldState('low')
+  s = step(s, { correct: true, switchedActivity: true })
+  assert.equal(s.currentLevel, 'medium', 'asking for another way brings support on that turn')
+  const a = step(makeScaffoldState('medium'), { ...open, elapsedMs: 5000 })
+  const b = step(makeScaffoldState('medium'), { ...open, elapsedMs: 10 * 60 * 1000 })
+  assert.deepEqual(a, b, 'time spent does not change the decision')
+})
+
+scenario('difficulty: a skill already shown elsewhere starts with less support', () => {
+  const m = createLearnerModel()
+  const canDo = ARC[0].canDoId
+  for (const item of productiveItemsOf(canDo)) {
+    recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+    recordItemAttempt(m, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 + DAY })
+  }
+  // shown in another context: a consolidation block of a daily session
+  recordCanDoAttempt(m, canDo, { success: true, independent: true, context: 'session:consolidation', atMs: T0 + DAY })
+  // (items alone, never attempted as the skill, are deliberately NOT enough)
+  const itemsOnly = createLearnerModel()
+  for (const item of productiveItemsOf(canDo)) {
+    recordItemAttempt(itemsOnly, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 })
+    recordItemAttempt(itemsOnly, item, { correct: true, independent: true, evidenceKind: 'open', atMs: T0 + DAY })
+  }
+  assert.ok(!deriveInitialScaffold({ learnerModel: itemsOnly, targetCanDo: canDo }).reasonCodes.includes(REASONS.TARGET_CAN_USE))
+  const known = deriveInitialScaffold({ learnerModel: m, targetCanDo: canDo, atMs: T0 + 2 * DAY })
+  const unknown = deriveInitialScaffold({ learnerModel: createLearnerModel(), targetCanDo: canDo, atMs: T0 + 2 * DAY })
+  assert.ok(known.reasonCodes.includes(REASONS.TARGET_CAN_USE), known.reasonCodes.join(','))
+  const rank = { high: 0, medium: 1, low: 2 }
+  assert.ok(rank[known.currentLevel] > rank[unknown.currentLevel], `${known.currentLevel} vs ${unknown.currentLevel}`)
+})
+
+console.log(`\ncheck-teaching-decisions — ${passed} passed, ${failures.length} failed`)
+if (failures.length) process.exit(1)
diff -ruN a/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs b/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs
--- a/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/curriculum-readiness-matrix.mjs	2026-10-31 16:04:27.184030000 -0300
@@ -0,0 +1,155 @@
+#!/usr/bin/env node
+/*
+ * curriculum-readiness-matrix — the Pre-A1 / A1 coverage tables, computed (P3).
+ *
+ * Every number in docs/curriculum/pre-a1-a1-readiness-matrix.md between the
+ * generated markers comes from here: the runtime skeleton, the content loader
+ * (each episode's content is really loaded), the level gate, the eight
+ * locales, the A1 blueprint and the test suites that cover each episode.
+ * Nothing is typed by hand, so the matrix cannot claim more than the code has.
+ *
+ *   node scripts/curriculum-readiness-matrix.mjs           print the tables
+ *   node scripts/curriculum-readiness-matrix.mjs --write   refresh the document
+ *   node scripts/curriculum-readiness-matrix.mjs --check   fail if it is stale
+ */
+import { readFileSync, writeFileSync, readdirSync, statSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { EPISODE_SKELETON } from '../src/learning/curriculum/preA1Skeleton.generated.js'
+import { loadEpisodeContent, episodeRequest, hasContentLoader } from '../src/learning/curriculum/episodeContent.js'
+import { PRE_A1_EXIT_CRITERIA } from '../src/learning/curriculum/preA1Map.js'
+import { isLevelAvailable } from '../src/learning/curriculum/levels.js'
+import { extractBase, extractLocale, LOCALE_ORDER, TRANSLATIONS_PATH, LOCALES_DIR } from './lib/i18nSource.mjs'
+
+const ROOT = fileURLToPath(new URL('..', import.meta.url))
+const REPO = join(ROOT, '..')
+const DOC = join(REPO, 'docs/curriculum/pre-a1-a1-readiness-matrix.md')
+const blueprint = JSON.parse(readFileSync(join(REPO, 'docs/curriculum/a1-blueprint.json'), 'utf8'))
+
+const OPEN = new Set(['free_reply'])
+const RECALL = new Set(['recall'])
+const CLOSED = new Set(['choice', 'word_order', 'fill_blank', 'comprehension'])
+
+// i18n: the English source and each locale, read exactly as the i18n checks read them
+const base = extractBase(readFileSync(TRANSLATIONS_PATH, 'utf8')).dict
+const locales = Object.fromEntries(LOCALE_ORDER.map(code => [code, extractLocale(readFileSync(join(LOCALES_DIR, `${code}.js`), 'utf8')).dict]))
+
+function files(dir, out = []) {
+  for (const name of readdirSync(dir)) {
+    const path = join(dir, name)
+    if (['node_modules', '.venv', '__pycache__'].includes(name)) continue
+    if (statSync(path).isDirectory()) files(path, out)
+    else if (/\.(mjs|py)$/.test(name) && !name.startsWith('curriculum-readiness-matrix')) out.push(path)
+  }
+  return out
+}
+const testSources = [...files(join(ROOT, 'scripts')), ...files(join(REPO, 'linguachat-backend/tests'))]
+  .map(path => ({ path: path.replace(/\\/g, '/'), text: readFileSync(path, 'utf8') }))
+
+// Suites that walk a whole level or arc without naming each episode id.
+const LEVEL_WIDE = {
+  'Pre-A1': /check-pre-a1-journeys|check-pedagogical-journeys|check-pre-a1-freeze|check-episodes\.mjs|check-arc-e2e/,
+  A1: /check-a1-longitudinal-journeys|check-pedagogical-journeys|check-a1-blueprint/,
+}
+
+async function episodeRows(level) {
+  const rows = []
+  for (const ep of EPISODE_SKELETON.filter(e => e.level === level)) {
+    const types = ep.steps.map(s => s.type)
+    let loaded = 0
+    try { loaded = (await loadEpisodeContent({ episodeId: ep.id, forLearner: false })).steps?.length || 0 } catch { loaded = 0 }
+    const prefix = ep.titleKey.replace(/Title$/, '')
+    const keys = Object.keys(base).filter(k => k.startsWith(prefix) && /^[A-Z]/.test(k.slice(prefix.length)))
+    const missing = LOCALE_ORDER.filter(code => keys.some(k => !locales[code][k]))
+    const arcOrder = level === 'A1' ? blueprint.arcs.find(a => a.id === ep.arc)?.order : null
+    const arcModule = arcOrder ? new RegExp(`a1Arc_?${arcOrder}(?![0-9])`) : null
+    const byId = testSources.filter(t => t.text.includes(`'${ep.id}'`) || t.text.includes(`"${ep.id}"`)).length
+    const byArc = testSources.filter(t => t.text.includes(`'${ep.arc}'`) || (arcModule && arcModule.test(t.text))
+      || LEVEL_WIDE[level].test(t.path)).length
+    rows.push({
+      id: ep.id, arc: ep.arc, canDo: ep.canDoId, secondary: ep.secondaryCanDoId || null,
+      open: types.filter(t => OPEN.has(t)).length,
+      recall: types.filter(t => RECALL.has(t)).length,
+      closed: types.filter(t => CLOSED.has(t)).length,
+      loader: hasContentLoader(level === 'Pre-A1' ? 'pre_a1' : 'a1', ep.arc),
+      loadedSteps: loaded,
+      learnerCanOpen: episodeRequest({ episodeId: ep.id }).ok,
+      keys: keys.length,
+      localesComplete: missing.length === 0 ? '8/8' : `${8 - missing.length}/8 (${missing.join(',')})`,
+      byId, byArc,
+    })
+  }
+  return rows
+}
+
+function table(rows) {
+  const head = '| Episodio | Arco | Capacidad | Abiertas | Recuerdo | Cerradas | Contenido carga (pasos) | Estudiante puede abrir | Claves i18n | Idiomas completos | Pruebas: por id / por arco o nivel |'
+  const sep = '|---|---|---|---|---|---|---|---|---|---|---|'
+  const line = r => [
+    '`' + r.id + '`', r.arc, r.canDo + (r.secondary ? ` (+${r.secondary})` : ''), r.open, r.recall, r.closed,
+    r.loader && r.loadedSteps ? `sí (${r.loadedSteps})` : 'NO', r.learnerCanOpen ? 'sí' : 'no (cerrado)',
+    r.keys, r.localesComplete, `${r.byId} / ${r.byArc}`,
+  ].join(' | ')
+  return [head, sep, ...rows.map(r => `| ${line(r)} |`)].join('\n')
+}
+
+function coverage(canDos, rows) {
+  const head = '| Capacidad | Alcance | Episodios (propio o secundario) | Producciones abiertas | Pasos de recuerdo diferido | Reutilizada en otros episodios (transferencia) |'
+  const sep = '|---|---|---|---|---|---|'
+  const lines = canDos.map(c => {
+    const own = rows.filter(r => r.canDo === c.id || r.secondary === c.id)
+    const reuse = EPISODE_SKELETON.filter(e => (e.reuseSkills || []).includes(c.id)).length
+    return `| ${c.id} | ${c.scope} | ${own.length} | ${own.reduce((n, r) => n + r.open, 0)} | ${own.reduce((n, r) => n + r.recall, 0)} | ${reuse} |`
+  })
+  return [head, sep, ...lines].join('\n')
+}
+
+export async function computeMatrix() {
+  const pre = await episodeRows('Pre-A1')
+  const a1 = await episodeRows('A1')
+  const preCanDos = PRE_A1_EXIT_CRITERIA.requiredCanDos.map(id => ({ id, scope: 'required (exit)' }))
+  const a1CanDos = blueprint.canDos.map(c => ({ id: c.id, scope: c.scope }))
+  const uncovered = a1CanDos.filter(c => !a1.some(r => r.canDo === c.id || r.secondary === c.id)).map(c => c.id)
+  const sum = (rows, key) => rows.reduce((n, r) => n + r[key], 0)
+  const summary = [
+    '| Medida | Pre-A1 | A1 |',
+    '|---|---|---|',
+    `| Nivel abierto a estudiantes | ${isLevelAvailable('pre_a1') ? 'sí' : 'no'} | ${isLevelAvailable('a1') ? 'sí' : 'no'} |`,
+    `| Episodios en runtime / planificados | ${pre.length} / 17 | ${a1.length} / ${blueprint.episodes.length} |`,
+    `| Episodios cuyo contenido carga de verdad | ${pre.filter(r => r.loadedSteps).length} | ${a1.filter(r => r.loadedSteps).length} |`,
+    `| Episodios que un estudiante puede abrir hoy | ${pre.filter(r => r.learnerCanOpen).length} | ${a1.filter(r => r.learnerCanOpen).length} |`,
+    `| Episodios con i18n completo en los 8 idiomas | ${pre.filter(r => r.localesComplete === '8/8').length} | ${a1.filter(r => r.localesComplete === '8/8').length} |`,
+    `| Producciones abiertas (free_reply) | ${sum(pre, 'open')} | ${sum(a1, 'open')} |`,
+    `| Pasos de recuerdo diferido (recall) | ${sum(pre, 'recall')} | ${sum(a1, 'recall')} |`,
+    `| Episodios sin prueba que los nombre por id | ${pre.filter(r => !r.byId).length} | ${a1.filter(r => !r.byId).length} |`,
+    `| Episodios sin ninguna prueba (ni por id ni por arco/nivel) | ${pre.filter(r => !r.byId && !r.byArc).length} | ${a1.filter(r => !r.byId && !r.byArc).length} |`,
+    `| Capacidades del blueprint sin episodio (propio o secundario) | — | ${uncovered.length ? uncovered.join(', ') : 'ninguna'} |`,
+  ].join('\n')
+  return [
+    '### Resumen calculado', '', summary, '',
+    '### Pre-A1 — episodios', '', table(pre), '',
+    '### Pre-A1 — capacidades exigidas para graduarse', '', coverage(preCanDos, pre), '',
+    '### A1 — episodios', '', table(a1), '',
+    '### A1 — capacidades del blueprint', '', coverage(a1CanDos, a1),
+  ].join('\n')
+}
+
+const START = '<!-- generated:start (node scripts/curriculum-readiness-matrix.mjs --write) -->'
+const END = '<!-- generated:end -->'
+
+const generated = await computeMatrix()
+if (process.argv.includes('--write') || process.argv.includes('--check')) {
+  const doc = readFileSync(DOC, 'utf8')
+  const a = doc.indexOf(START), b = doc.indexOf(END)
+  if (a < 0 || b < a) throw new Error('generated markers missing in ' + DOC)
+  const next = doc.slice(0, a + START.length) + '\n\n' + generated + '\n\n' + doc.slice(b)
+  if (process.argv.includes('--check')) {
+    if (next !== doc) { console.error('curriculum-readiness-matrix — STALE: run with --write'); process.exit(1) }
+    console.log('curriculum-readiness-matrix — OK (the document matches the runtime)')
+  } else {
+    writeFileSync(DOC, next)
+    console.log('curriculum-readiness-matrix — written')
+  }
+} else {
+  console.log(generated)
+}
diff -ruN a/linguachat-frontend/scripts/e2e-chat-continuity.mjs b/linguachat-frontend/scripts/e2e-chat-continuity.mjs
--- a/linguachat-frontend/scripts/e2e-chat-continuity.mjs	1969-12-31 21:00:00.000000000 -0300
+++ b/linguachat-frontend/scripts/e2e-chat-continuity.mjs	2026-10-31 16:08:35.707025000 -0300
@@ -0,0 +1,120 @@
+#!/usr/bin/env node
+/*
+ * e2e-chat-continuity — the whole loop across the real HTTP boundary (P3).
+ *
+ * Needs a running backend with the free local engine:
+ *   cd linguachat-backend && LINGUACHAT_PROVIDER=local python -m uvicorn main:app --port 8000
+ *   node scripts/e2e-chat-continuity.mjs [http://127.0.0.1:8000]
+ *
+ * Each learner sends real messages to POST /chat. The device side is the real
+ * frontend code: services/chatAnalysis.js reduces the reply, chatEvidence.js
+ * classifies and records it in a real learner model, and the memory it builds
+ * travels back in the next request — exactly what AppContext does. Days are
+ * simulated by the turn times; nothing about the server is mocked.
+ *
+ * Not part of check:all (it needs a server). The P3 report records its run.
+ */
+import assert from 'node:assert/strict'
+import { safeAnalysis } from '../src/services/chatAnalysis.js'
+import { classifyChatTurn, recordChatTurn, chatDifficulties, learningMemoryPayload } from '../src/learning/engine/chatEvidence.js'
+import { createLearnerModel } from '../src/learning/engine/learnerModel.js'
+import { isLevelAvailable } from '../src/learning/curriculum/levels.js'
+
+const API = process.argv[2] || 'http://127.0.0.1:8000'
+const DAY = 86400000
+const T0 = Date.UTC(2026, 9, 10, 9)
+let passed = 0
+const failures = []
+async function scenario(name, run) {
+  try { await run(); passed++; console.log('  ok  ' + name) }
+  catch (error) { failures.push(name); console.log('  FAIL ' + name + '\n       ' + String(error.message).split('\n')[0]) }
+}
+
+function learner(lang) {
+  const model = createLearnerModel()
+  let last = null, n = 0
+  return {
+    model,
+    set lang(v) { lang = v },
+    async say(message, { day = 0, minute = 0, session = `day${day}`, assisted = false } = {}) {
+      const at = T0 + day * DAY + minute * 60000
+      const res = await fetch(`${API}/chat`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ session_id: `${lang}-${session}`, message, level: 'A1', native_language: lang,
+          learning_memory: learningMemoryPayload(model, at) }),
+      })
+      assert.equal(res.status, 200)
+      const data = await res.json()
+      const analysis = safeAnalysis(data.analysis)
+      const c = classifyChatTurn({ turnId: `t${++n}`, at, message, analysis, assisted, model,
+        previous: last ? { correction: last.correction, retrieval: last.retrieval } : null })
+      recordChatTurn(model, c)
+      last = { correction: data.correction, retrieval: analysis?.retrieval || null }
+      return { data, kind: c.kind, at }
+    },
+    difficulty: (rule, at) => chatDifficulties(model, at).find(d => d.rule === rule),
+  }
+}
+
+await scenario('a beginner across five days: error → copy → delayed retrieval → transfer, never mastery', async () => {
+  const l = learner('es')
+  const d1 = await l.say('Yesterday I goed to school.', { day: 0 })
+  assert.equal(d1.kind, 'error'); assert.equal(d1.data.analysis.strategy, 'brief_explanation')
+  assert.equal((await l.say('Yesterday I went to school.', { day: 0, minute: 1 })).kind, 'copied')
+  // day 2: the device says it is due; the tutor offers a retrieval with a new verb
+  const d2 = await l.say('I like my job.', { day: 1, minute: 60 })
+  const retrieval = d2.data.analysis.retrieval
+  assert.ok(retrieval && retrieval.base !== 'go', 'a delayed retrieval in a new sentence')
+  assert.match(d2.data.learning_action.prompt, /Un repaso rápido de otro día/)
+  assert.equal((await l.say(retrieval.expected, { day: 1, minute: 62 })).kind, 'retrieval')
+  // day 5: spontaneous use of another irregular past
+  assert.equal((await l.say('Last weekend we swam in the lake.', { day: 4 })).kind, 'transfer')
+  const d = l.difficulty('past_irregular', T0 + 4 * DAY + 1)
