  * the English base, so the UI never shows raw keys. Callers that want to avoid
  * even a brief English flash can await `loadLocale` first (AppContext does).
  */
+/*
+ * The closed levels' English (B1–C2) lives in its own chunk; see
+ * closedLevelsEn.js. Merged into `base` once, so `translate` stays
+ * synchronous for everything already on screen. Keys already present win.
+ */
+let closedLevelStrings = null
+export function loadClosedLevelStrings() {
+  if (!closedLevelStrings) {
+    closedLevelStrings = import('./closedLevelsEn.js').then(({ CLOSED_LEVELS_EN }) => {
+      for (const [key, value] of Object.entries(CLOSED_LEVELS_EN)) if (!(key in base)) base[key] = value
+      return true
+    }).catch((error) => { closedLevelStrings = null; throw error })
+  }
+  return closedLevelStrings
+}
