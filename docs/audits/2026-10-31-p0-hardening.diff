+    kind: 'practice',
+    at,
+    day: dateKey(new Date(at)),
+    xp: 10 + (response.correction ? 5 : 0),
+    corrected: Boolean(response.correction),
+    topics: inferTopics(message, response),
+    learned: candidate?.phrase && candidate.phrase.length <= 100
