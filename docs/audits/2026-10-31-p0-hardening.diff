+// `saveStoredMessages(messages, { access })`, run after every state change.
+function persist(tab) {
+  return tab.act(() => ({
+    progress: saveLocalProgress(tab.progress, { access: tab.access }),
+    messages: saveStoredMessages(tab.messages, { access: tab.access }),
+  }))
