    {
      "id": 3,
      "check": "First unaided attempt, meaningful delayed seen-item retrieval and independently reviewed unseen transfer are distinct evidence claims."
    },
    {
      "id": 4,
      "check": "Only actually delivered answer-bearing material before submission contaminates that attempt; later feedback does not retroactively contaminate earlier valid evidence; UNKNOWN is not clean."
    },
    {
      "id": 5,
      "check": "Assisted repairs do not certify independent mastery; accommodations are not cheating; text cannot discharge listening or speaking obligations."
    },
    {
      "id": 6,
      "check": "Method comparison controls item exposure/family, baseline, difficulty, channel, interest, access, timing and missingness; no naive causal winner."
    },
    {
      "id": 7,
      "check": "Deduplicate stable attempts; preserve trusted occurrence versus arrival, actual render history and due/offered/rendered/completed/missing counts."
    },
    {
      "id": 8,
      "check": "Retain uncertain reversible hypotheses and feasible alternatives; matched controls may change future actually delivered choices, never prior snapshots or fixed learning-style labels."
    },
    {
      "id": 9,
