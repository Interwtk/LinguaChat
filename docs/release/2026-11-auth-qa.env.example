# Real auth QA: copy to a private file OUTSIDE the repository and fill in.
# Only a separate, owner-authorized TEST project. Never production.
# Only the public URL and the public anon key. Never a service_role key.
QA_AUTH_URL=https://<test-project-ref>.supabase.co
QA_AUTH_ANON_KEY=<public anon key of the TEST project>
QA_AUTH_AUTHORIZED_HOST=<test-project-ref>.supabase.co
QA_AUTH_CONFIRM_TEST_PROJECT=yes
QA_AUTH_EMAIL_A=<owner alias +test1>
QA_AUTH_EMAIL_B=<owner alias +test2>
QA_AUTH_PASSWORD=<throwaway password, used only for these two aliases>

# Optional: the server half. Only once the backend verifies sign-in in this Preview.
# QA_API_URL=https://<preview-host>
# QA_API_AUTHORIZED_HOST=<preview-host>
# QA_API_PRODUCTION_HOST=<production-host>
# QA_VERCEL_BYPASS=   (keep it in this file only; never share it in a chat)
