# Real auth QA: copy to a private file OUTSIDE the repository and fill in.
# The EXISTING LinguaChat project (owner's decision, phase 7). Never an EvoLabs project.
# Only the public URL and the public key (anon or sb_publishable_). Never a secret key.
# Test accounts only: both addresses must contain +lcqa. No real learner is ever used.
QA_AUTH_URL=https://<linguachat-project-ref>.supabase.co
QA_AUTH_ANON_KEY=<public key of the LinguaChat project>
QA_AUTH_AUTHORIZED_HOST=<linguachat-project-ref>.supabase.co
QA_AUTH_CONFIRM_LINGUACHAT_PROJECT=yes
QA_AUTH_EMAIL_A=<you+lcqa-a@your-mail>
QA_AUTH_EMAIL_B=<you+lcqa-b@your-mail>
QA_AUTH_PASSWORD=<throwaway password, used only for these two test accounts>

# Optional: the server half. Only once the backend verifies sign-in in this Preview.
# QA_API_URL=https://<preview-host>
# QA_API_AUTHORIZED_HOST=<preview-host>
# QA_API_PRODUCTION_HOST=<production-host>
# QA_VERCEL_BYPASS=   (keep it in this file only; never share it in a chat)
